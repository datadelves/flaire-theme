{%- comment -%}
  Everything kernel.js needs from Liquid: store routes, theme settings that change behavior, and UI strings
  (editable in Online Store > Themes > Edit default theme content). {name} placeholders are filled by the kernel.
{%- endcomment -%}
<script>
  window.Flaire = {
    routes: {
      root: {{ routes.root_url | json }},
      cart: {{ routes.cart_url | json }},
      cartAdd: {{ routes.cart_add_url | json }},
      cartChange: {{ routes.cart_change_url | json }},
      cartUpdate: {{ routes.cart_update_url | json }},
      search: {{ routes.search_url | json }},
      predictiveSearch: {{ routes.predictive_search_url | json }},
      recommendations: {{ routes.product_recommendations_url | json }},
      account: {{ routes.account_url | json }}
    },
    settings: {
      cartType: {{ settings.cart_type | json }},
      cartAutoOpen: {{ settings.cart_auto_open | json }},
      quickAddMode: {% if settings.quick_view_enabled %}{{ settings.quick_add_mode | json }}{% else %}"off"{% endif %},
      predictiveSearch: {{ settings.predictive_search_enabled | json }},
      predictiveLimit: {{ settings.predictive_search_limit | default: 4 }},
      lowStock: {{ settings.inventory_low_threshold | default: 5 }},
      showStockCount: {{ settings.inventory_show_count | json }}
    },
    moneyFormat: {{ shop.money_format | json }},
    moneySample: {{ 123456789 | money | json }},
    strings: {
      bag: {{ 'cart.general.title' | t | json }},
      bagCount: {{ 'cart.general.title_count' | t: count: '__count__' | json }},
      bagButton: {{ 'accessibility.bag' | t | json }},
      bagButtonOne: {{ 'accessibility.bag_count_one' | t | json }},
      bagButtonCount: {{ 'accessibility.bag_count' | t: count: '__count__' | json }},
      adding: {{ 'products.product.adding' | t | json }},
      added: {{ 'products.product.added' | t | json }},
      addedShort: {{ 'products.product.added_short' | t | json }},
      addedAnnounce: {{ 'products.product.added_announce' | t: title: '__title__' | json }},
      addToBag: {{ 'products.product.add_to_bag' | t | json }},
      soldOut: {{ 'products.product.sold_out' | t | json }},
      soldOutSuffix: {{ 'products.product.sold_out_suffix' | t | json }},
      soldOutText: {{ 'products.product.sold_out_text' | t | json }},
      select: {{ 'products.product.select' | t | json }},
      selectSize: {{ 'products.product.select_size' | t | json }},
      selectLength: {{ 'products.product.select_length' | t | json }},
      selectToContinue: {{ 'products.product.select_to_continue' | t: option: '__option__' | json }},
      chooseAvailable: {{ 'products.product.choose_available' | t | json }},
      chooseAvailableShort: {{ 'products.product.choose_available_short' | t | json }},
      deliveryFree: {{ 'products.product.delivery_free' | t | json }},
      sizeValue: {{ 'products.product.size_value' | t: value: '__value__' | json }},
      sizeValueCap: {{ 'products.product.size_value_cap' | t: value: '__value__' | json }},
      sku: {{ 'products.product.sku' | t: sku: '__sku__' | json }},
      shipsTomorrow: {{ 'products.product.ships_tomorrow' | t | json }},
      readyEngraved: {{ 'products.product.ready_engraved' | t | json }},
      returnsToAdd: {{ 'products.product.returns_to_add' | t | json }},
      updatesBag: {{ 'products.product.updates_bag' | t | json }},
      editPiece: {{ 'products.product.edit_piece' | t | json }},
      chooseFinishSize: {{ 'products.product.choose_finish_size' | t | json }},
      bagUpdated: {{ 'products.product.bag_updated' | t | json }},
      comboSoldToast: {{ 'products.product.combo_sold_toast' | t | json }},
      allInBag: {{ 'products.product.all_in_bag' | t | json }},
      onlyMore: {{ 'products.product.only_more' | t: count: '__count__' | json }},
      onlyInBag: {{ 'products.product.only_in_bag' | t: count: '__count__' | json }},
      addError: {{ 'products.product.add_error' | t | json }},
      quickViewLoaded: {{ 'products.product.quick_view_loaded' | t: title: '__title__' | json }},
      networkError: {{ 'general.errors.network' | t | json }},
      tryAgain: {{ 'general.errors.try_again' | t | json }},
      genericError: {{ 'general.errors.generic' | t | json }},
      removed: {{ 'cart.general.removed' | t: title: '__title__' | json }},
      removedAnnounce: {{ 'cart.general.removed_announce' | t | json }},
      restored: {{ 'cart.general.restored' | t | json }},
      undo: {{ 'cart.general.undo' | t | json }},
      quantityLimit: {{ 'cart.general.quantity_limit_lower' | t: count: '__count__' | json }},
      discountInvalid: {{ 'cart.discount.invalid' | t | json }},
      discountEmpty: {{ 'cart.discount.empty' | t | json }},
      discountApplied: {{ 'cart.discount.applied_announce' | t | json }},
      discountRemoved: {{ 'cart.discount.removed_announce' | t | json }},
      zipInvalid: {{ 'cart.shipping.zip_invalid' | t | json }},
      estimateNone: {{ 'cart.shipping.none' | t | json }},
      estimated: {{ 'cart.shipping.estimated' | t | json }},
      searching: {{ 'search.predictive.searching' | t | json }},
      searchCount: {{ 'search.predictive.count' | t: count: '__count__' | json }},
      noResults: {{ 'search.predictive.no_results_announce' | t | json }},
      piecesOne: {{ 'general.pieces.one' | t: count: '__count__' | json }},
      piecesOther: {{ 'general.pieces.other' | t: count: '__count__' | json }},
      countriesOne: {{ 'localization.results.one' | t: count: '__count__' | json }},
      countriesOther: {{ 'localization.results.other' | t: count: '__count__' | json }},
      loadingMore: {{ 'general.loading_more' | t | json }},
      copied: {{ 'general.copied' | t | json }},
      copyCode: {{ 'general.copy_code' | t | json }},
      codeCopied: {{ 'gift_cards.copied' | t | json }},
      copyFailed: {{ 'gift_cards.copy_failed' | t | json }},
      linkCopied: {{ 'products.product.link_copied' | t | json }},
      copyFromBar: {{ 'products.product.copy_from_bar' | t | json }},
      engravingInvalidOne: {{ 'products.engraving.remove_symbol' | t: chars: '__chars__' | json }},
      engravingInvalidMany: {{ 'products.engraving.remove_symbols' | t: chars: '__chars__' | json }},
      engravingTooLong: {{ 'products.engraving.too_long' | t: max: '__max__' | json }},
      engravingCount: {{ 'products.engraving.count' | t: count: '__count__', max: '__max__' | json }},
      engravingEmpty: {{ 'products.engraving.empty' | t: max: '__max__' | json }},
      engravingPreview: {{ 'products.engraving.preview_label' | t: text: '__text__' | json }},
      engravingPreviewEmpty: {{ 'products.engraving.preview_empty' | t | json }},
      engravingSampleNote: {{ 'products.engraving.sample_note' | t | json }},
      imageCount: {{ 'accessibility.image_count' | t: index: '__index__', count: '__count__' | json }},
      slideOf: {{ 'accessibility.slide_of' | t: index: '__index__', count: '__count__' | json }},
      pause: {{ 'accessibility.pause_slideshow' | t | json }},
      play: {{ 'accessibility.play_slideshow' | t | json }},
      formProblem: {{ 'general.form.problem' | t | json }},
      fixOne: {{ 'general.form.fix_one' | t | json }},
      fixMany: {{ 'general.form.fix_many' | t | json }},
      problemOne: {{ 'general.form.problem_one' | t | json }},
      problemMany: {{ 'general.form.problem_many' | t: count: '__count__' | json }},
      required: {{ 'general.form.required' | t: label: '__label__' | json }},
      emailEmpty: {{ 'general.form.email_empty' | t | json }},
      emailInvalid: {{ 'general.email_invalid' | t | json }},
      minLength: {{ 'general.form.min_length' | t: count: '__count__' | json }},
      patternInvalid: {{ 'general.form.pattern' | t | json }},
      somethingWrong: {{ 'general.form.something_wrong' | t | json }},
      dismissed: {{ 'general.dismissed' | t | json }}
    }
  };
</script>
