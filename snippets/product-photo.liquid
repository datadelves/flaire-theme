{%- comment -%}
  Product photograph as the prototype draws it: a transparent cut-out <img class="fc-photo"> that sits on the
  card or plate ground. With no image the Facet Specimen placeholder is drawn instead.

  Accepts:
  - image {Object} image or media (media uses its preview_image)
  - size {Number} display size in px (sets width/height and the srcset range, default 200)
  - alt {String} alt text (default image alt, then product title); pass '' for decorative use
  - class {String} extra classes (e.g. m-front, m-detail)
  - loading {String} lazy | eager (default lazy)
  - fetchpriority {String}
  - sizes {String} sizes attribute (default "{size}px")
  - attrs {String} raw extra attributes
  - kind, metal, gem {String} specimen fallback (see snippets/specimen.liquid)

  Usage: {% render 'product-photo', image: product.featured_media, size: 180, alt: product.title %}
{%- endcomment -%}
{%- liquid
  assign size = size | default: 200
  assign img = image
  if image.preview_image
    assign img = image.preview_image
  endif
  if alt == nil
    assign alt_text = img.alt | default: ''
  else
    assign alt_text = alt
  endif
-%}
{%- if img != blank -%}
  {%- liquid
    assign w1 = size
    assign w2 = size | times: 2
    assign w3 = size | times: 3
    if w3 > img.width
      assign w3 = img.width
    endif
    if w2 > img.width
      assign w2 = img.width
    endif
    if w1 > img.width
      assign w1 = img.width
    endif
    assign src_w = size | times: 2
    if src_w > img.width
      assign src_w = img.width
    endif
    assign sizes_attr = sizes
    if sizes_attr == blank
      assign sizes_attr = size | append: 'px'
    endif

    # srcset: half, 1x, 2x and 3x the display size, capped at the file's width, each width listed once
    # (a smaller candidate lets phones and small slots download less)
    assign w0 = size | divided_by: 2
    if w0 > img.width
      assign w0 = img.width
    endif
    assign u0 = img | image_url: width: w0
    assign u1 = img | image_url: width: w1
    assign u2 = img | image_url: width: w2
    assign u3 = img | image_url: width: w3
    capture srcset_attr
      echo u0 | append: ' ' | append: w0 | append: 'w'
      if w1 > w0
        echo ', ' | append: u1 | append: ' ' | append: w1 | append: 'w'
      endif
      if w2 > w1
        echo ', ' | append: u2 | append: ' ' | append: w2 | append: 'w'
      endif
      if w3 > w2
        echo ', ' | append: u3 | append: ' ' | append: w3 | append: 'w'
      endif
    endcapture
    # focal point set in the image picker or Files (image_tag does this automatically)
    assign focal = img.presentation.focal_point
  -%}
  <img class="fc-photo{% if class != blank %} {{ class }}{% endif %}" src="{{ img | image_url: width: src_w }}" srcset="{{ srcset_attr }}" sizes="{{ sizes_attr }}"{% if focal != blank %} style="object-position:{{ focal }}"{% endif %} width="{{ size }}" height="{{ size }}" alt="{{ alt_text | escape }}" loading="{{ loading | default: 'lazy' }}"{% if fetchpriority != blank %} fetchpriority="{{ fetchpriority }}"{% endif %} decoding="async" draggable="false"{% if attrs != blank %} {{ attrs }}{% endif %}>
{%- else -%}
  {%- render 'specimen', kind: kind, metal: metal, gem: gem, size: size, label: alt_text, class: class -%}
{%- endif -%}
