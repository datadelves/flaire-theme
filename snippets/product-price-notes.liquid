{%- comment -%}
  Fine print under a product price: "Taxes included." when the store's prices include tax
  (cart.taxes_included), and "Shipping calculated at checkout." linking the shipping policy when the store
  has one. Renders nothing when neither applies.

  Usage: {% render 'product-price-notes' %}
{%- endcomment -%}
{%- liquid
  assign has_policy = false
  if shop.shipping_policy.body != blank
    assign has_policy = true
  endif
-%}
{%- if cart.taxes_included or has_policy -%}
  <p class="t-fine dl-price-notes" data-tax-note>
    {%- if cart.taxes_included -%}{{ 'products.price_notes.taxes_included' | t }}{%- endif -%}
    {%- if has_policy -%}{% if cart.taxes_included %} {% endif %}{{ 'products.price_notes.shipping_policy_html' | t: link: shop.shipping_policy.url }}{%- endif -%}
  </p>
{%- endif -%}
