{%- comment -%}
  JSON-LD for the whole store: Organization (footer brand) and WebSite with a search action.
  Product, BreadcrumbList and Article data are output by their own sections.
{%- endcomment -%}
{%- liquid
  assign org_name = settings.brand_name | default: shop.name
  assign same_as = ''
  assign social_keys = 'social_instagram,social_pinterest,social_tiktok,social_youtube,social_facebook' | split: ','
  for key in social_keys
    if settings[key] != blank
      assign same_as = same_as | append: settings[key] | append: '|'
    endif
  endfor
  assign same_as = same_as | split: '|'
  assign search_target = request.origin | append: routes.search_url | append: '?q={search_term_string}'
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ org_name | json }},
    "url": {{ request.origin | append: routes.root_url | json }}
    {%- if settings.logo != blank -%},
    "logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }}
    {%- endif -%}
    {%- if same_as.size > 0 -%},
    "sameAs": {{ same_as | json }}
    {%- endif %}
  }
</script>
{%- if request.page_type == 'index' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "url": {{ request.origin | append: routes.root_url | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ search_target | json }},
        "query-input": "required name=search_term_string"
      }
    }
  </script>
{%- endif -%}
