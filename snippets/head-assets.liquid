{%- comment -%}
  The assets every page needs in <head>: fonts, Facet CSS, color schemes, the no-JS switch and the kernel.
  Shared by layout/theme.liquid, layout/password.liquid and templates/gift_card.liquid so they stay in step.
{%- endcomment -%}
{% render 'font-faces' %}

{{ 'tokens.css' | asset_url | stylesheet_tag }}
{{ 'base.css' | asset_url | stylesheet_tag }}
{{ 'theme.css' | asset_url | stylesheet_tag }}
{% render 'color-schemes' %}

<script>
  document.documentElement.classList.replace('no-js', 'js');
  try { var dk = sessionStorage.getItem('dl-announce-dismissed'); if (dk && !(window.Shopify && Shopify.designMode)) { var st = document.createElement('style'); st.textContent = '.dl-announce[data-dismiss-key="' + dk.replace(/[^a-z0-9]/gi, '') + '"]{display:none}'; document.head.appendChild(st); } } catch (e) {}
</script>
{% render 'kernel-config' %}
<script src="{{ 'kernel.js' | asset_url }}" defer></script>
