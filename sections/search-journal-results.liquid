{%- comment -%}
  Article and page matches as hairline rows. Mixed searches (no `type`) list the first non-product results;
  the Journal and Pages tabs (type=article / type=page) list every match, paginated by the row limit.
  Renders nothing when there are no article or page results, or on the Pieces tab.
{%- endcomment -%}
{%- liquid
  assign scheme = section.settings.color_scheme | default: 'scheme-2'
  assign limit = section.settings.limit | default: 6
  assign opts = section.blocks | where: 'type', 'row-options' | first
  assign show_excerpt = true
  assign show_date = true
  assign show_image = false
  if opts
    assign show_excerpt = opts.settings.show_excerpt
    assign show_date = opts.settings.show_date
    assign show_image = opts.settings.show_image
  endif
  assign help_blocks = section.blocks | where: 'type', 'help'
  assign note_block = section.blocks | where: 'type', 'note' | first

  assign single = false
  assign tab = 'mixed'
  if search.types.size == 1
    assign single = true
    assign tab = search.types.first
  endif
  assign show = false
  if search.performed and tab != 'product'
    for item in search.results
      if item.object_type == 'article' or item.object_type == 'page'
        assign show = true
        break
      endif
    endfor
  endif
-%}
{%- capture extras -%}
  {%- assign has_help = false -%}
  {%- for block in help_blocks -%}{%- if block.settings.label != blank and block.settings.link != blank -%}{%- assign has_help = true -%}{%- endif -%}{%- endfor -%}
  {%- if has_help -%}
    <div class="sjr-help">
      {%- for block in help_blocks -%}
        {%- if block.settings.label != blank and block.settings.link != blank -%}
          {%- assign help_label = block.settings.label | escape -%}
          {%- capture help_attrs -%}{{ block.shopify_attributes }}{%- endcapture -%}
          {%- render 'button', variant: 'link', label: help_label, url: block.settings.link, icon: block.settings.icon, attrs: help_attrs -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
  {%- if note_block and note_block.settings.show and note_block.settings.text != blank -%}
    <p class="t-fine" style="margin:var(--space-4) 0 0;text-align:{% if note_block.settings.align == 'center' %}center{% else %}left{% endif %}" {{ note_block.shopify_attributes }}>{{ note_block.settings.text | escape }}</p>
  {%- endif -%}
{%- endcapture -%}
{%- if show -%}
  <div class="band tight {{ scheme }}" data-section="search-journal-results" style="{% render 'section-padding', top: section.settings.padding_top, bottom: section.settings.padding_bottom, fixed: true %}">
    <div class="wrap-c">
      {%- render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.headline, sub: section.settings.sub, role: 't-title-lg', left: true -%}
      {%- if single -%}
        {%- paginate search.results by limit -%}
          <div style="border-top:1px solid var(--hairline)">
            {%- for item in search.results -%}
              {%- render 'search-journal-results-row', item: item, show_excerpt: show_excerpt, show_date: show_date, show_image: show_image -%}
            {%- endfor -%}
          </div>
          {%- render 'pagination', paginate: paginate -%}
        {%- endpaginate -%}
      {%- else -%}
        <div style="border-top:1px solid var(--hairline)">
          {%- assign shown = 0 -%}
          {%- for item in search.results -%}
            {%- if item.object_type == 'article' or item.object_type == 'page' -%}
              {%- render 'search-journal-results-row', item: item, show_excerpt: show_excerpt, show_date: show_date, show_image: show_image -%}
              {%- assign shown = shown | plus: 1 -%}
              {%- if shown >= limit %}{% break %}{% endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
      {{ extras }}
    </div>
  </div>
{%- elsif request.design_mode and search.performed == false -%}
  <div class="band tight {{ scheme }}" data-section="search-journal-results" style="{% render 'section-padding', top: section.settings.padding_top, bottom: section.settings.padding_bottom, fixed: true %}">
    <div class="wrap-c">
      {%- render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.headline, sub: section.settings.sub, role: 't-title-lg', left: true -%}
      <div style="border-top:1px solid var(--hairline)">
        {%- for article in blogs.journal.articles limit: 3 -%}
          {%- render 'search-journal-results-row', item: article, show_excerpt: show_excerpt, show_date: show_date, show_image: show_image -%}
        {%- endfor -%}
      </div>
      {{ extras }}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .sjr-row.has-thumb { display: grid !important; grid-template-columns: 80px minmax(0, 1fr); gap: var(--space-4); align-items: center; }
  .sjr-thumb { width: 80px; height: 80px; object-fit: cover; border-radius: var(--radius-lg); }
  .sjr-help { display: flex; flex-wrap: wrap; gap: var(--space-5); margin-top: var(--space-8); }
{% endstylesheet %}

{% schema %}
{
  "name": "Journal and page results",
  "tag": "section",
  "class": "dl-section dl-search-journal-results",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "headline",
      "label": "Headline",
      "default": "From the journal and pages"
    },
    {
      "type": "inline_richtext",
      "id": "sub",
      "label": "Supporting line"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2",
      "info": "Alternate schemes 1 and 2 down the page. Scheme 3 is dark."
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Rows",
      "default": 6,
      "min": 3,
      "max": 12,
      "step": 1
    },
    {
      "type": "header",
      "content": "Section padding",
      "info": "The same on every screen size."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 64,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 64,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "row-options",
      "name": "Row options",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_excerpt",
          "label": "Show excerpt",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_date",
          "label": "Show date",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_image",
          "label": "Show thumbnail",
          "default": false
        }
      ]
    },
    {
      "type": "help",
      "name": "Help link",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Ask a jeweler"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "chat-circle-dots",
          "options": [
            {
              "value": "info",
              "label": "Info"
            },
            {
              "value": "gift",
              "label": "Gift"
            },
            {
              "value": "truck",
              "label": "Truck"
            },
            {
              "value": "package",
              "label": "Package"
            },
            {
              "value": "seal-check",
              "label": "Seal check"
            },
            {
              "value": "storefront",
              "label": "Storefront"
            },
            {
              "value": "ruler",
              "label": "Ruler"
            },
            {
              "value": "envelope-simple",
              "label": "Envelope"
            },
            {
              "value": "phone",
              "label": "Phone"
            },
            {
              "value": "chat-circle-dots",
              "label": "Chat"
            }
          ]
        }
      ]
    },
    {
      "type": "note",
      "name": "Note",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "checkbox",
          "id": "show",
          "label": "Show",
          "default": false
        },
        {
          "type": "select",
          "id": "align",
          "label": "Align",
          "default": "start",
          "options": [
            {
              "value": "start",
              "label": "Start"
            },
            {
              "value": "center",
              "label": "Center"
            }
          ]
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": [
      "search"
    ]
  },
  "limit": 1
}
{% endschema %}
