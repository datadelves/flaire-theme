{%- liquid
  assign scheme = section.settings.color_scheme | default: 'scheme-1'
  assign heading = section.settings.headline
  if section.settings.use_page_title
    if page.title != blank
      assign heading = page.title | escape
    elsif heading == blank and page_title != blank
      assign heading = page_title | escape
    endif
  endif
  assign left = false
  assign text_align = 'center'
  assign crumb_justify = 'center'
  if section.settings.align == 'start'
    assign left = true
    assign text_align = 'left'
    assign crumb_justify = 'flex-start'
  endif
-%}
<div class="band tight {{ scheme }}" data-section="page-header" style="{% render 'section-padding', top: section.settings.padding_top, bottom: section.settings.padding_bottom, fixed: true %}">
  <div class="wrap-n" style="text-align:{{ text_align }}">
    {%- for block in section.blocks -%}
      {%- if block.type == 'breadcrumb' -%}
        <div style="margin-bottom:24px;display:flex;justify-content:{{ crumb_justify }}" {{ block.shopify_attributes }}>
          {%- liquid
            assign default_label = 'general.breadcrumb' | t
            assign use_snippet = false
            if block.settings.show_home
              if block.settings.label == blank or block.settings.label == default_label
                assign use_snippet = true
              endif
            endif
          -%}
          {%- if use_snippet -%}
            {%- render 'breadcrumb' -%}
          {%- else -%}
            {%- liquid
              assign crumb_label = block.settings.label | default: default_label
              assign crumb_current = page.title | default: page_title
            -%}
            <nav class="dl-crumb" aria-label="{{ crumb_label | escape }}">
              {%- if block.settings.show_home -%}
                <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>{% render 'icon', icon: 'caret-right', size: 12 %}
              {%- endif -%}
              <span aria-current="page">{{ crumb_current | escape }}</span>
            </nav>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}

    {%- render 'section-head', eyebrow: section.settings.eyebrow, heading: heading, sub: section.settings.sub, level: 1, left: left -%}

    {%- for block in section.blocks -%}
      {%- if block.type == 'meta' -%}
        {%- liquid
          assign meta_text = block.settings.text
          if block.settings.show_updated and page.updated_at != blank
            assign updated_date = page.updated_at | date: '%B %-d, %Y'
            assign updated = 'general.updated_on' | t: date: updated_date
            if meta_text != blank
              assign meta_text = meta_text | append: ' · ' | append: updated
            else
              assign meta_text = updated
            endif
          endif
        -%}
        {%- if meta_text != blank -%}
          <p class="t-caption" style="margin:0{% if block.settings.tone == 'ink' %};color:var(--ink){% endif %}" {{ block.shopify_attributes }}>{{ meta_text }}</p>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- for block in section.blocks -%}
    {%- if block.type == 'image' -%}
      {%- if block.settings.image != blank or request.design_mode -%}
        <div class="{% if block.settings.width == 'wide' %}wrap-c{% else %}wrap-n{% endif %}" {{ block.shopify_attributes }}>
          <div style="background:var(--canvas-alt);border-radius:var(--radius-xl);aspect-ratio:16/9;display:grid;place-items:center;overflow:hidden">
            {%- if block.settings.image != blank -%}
              {{- block.settings.image | image_url: width: 1960 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '692, 980, 1384, 1960', sizes: '(min-width: 1100px) 980px, 100vw', alt: block.settings.image_alt, style: 'width:100%;height:100%;object-fit:cover' -}}
            {%- else -%}
              {%- render 'specimen', kind: 'ring', metal: 'yellow-gold', size: 300, label: '' -%}
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Page header",
  "tag": "section",
  "class": "dl-section dl-page-header",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "headline",
      "label": "Headline"
    },
    {
      "type": "inline_richtext",
      "id": "sub",
      "label": "Supporting line"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1",
      "info": "Alternate schemes 1 and 2 down the page. Scheme 3 is dark."
    },
    {
      "type": "checkbox",
      "id": "use_page_title",
      "label": "Use page title",
      "default": true
    },
    {
      "type": "select",
      "id": "align",
      "label": "Align",
      "default": "center",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "start",
          "label": "Start"
        }
      ]
    },
    {
      "type": "header",
      "content": "Section padding",
      "info": "The same on every screen size."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 64,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 64,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "breadcrumb",
      "name": "Breadcrumb",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_home",
          "label": "Show home link",
          "default": true
        },
        {
          "type": "text",
          "id": "label",
          "label": "Accessible label",
          "default": "Breadcrumb"
        },
        {
          "type": "checkbox",
          "id": "compact",
          "label": "Compact",
          "default": true
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },
        {
          "type": "select",
          "id": "width",
          "label": "Width",
          "default": "content",
          "options": [
            {
              "value": "content",
              "label": "Content"
            },
            {
              "value": "wide",
              "label": "Wide"
            }
          ]
        }
      ]
    },
    {
      "type": "meta",
      "name": "Meta",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "checkbox",
          "id": "show_updated",
          "label": "Show updated date",
          "default": false
        },
        {
          "type": "select",
          "id": "tone",
          "label": "Tone",
          "default": "muted",
          "options": [
            {
              "value": "muted",
              "label": "Muted"
            },
            {
              "value": "ink",
              "label": "Default"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Page header",
      "blocks": [
        {
          "type": "breadcrumb"
        },
        {
          "type": "image"
        },
        {
          "type": "meta"
        }
      ]
    }
  ]
}
{% endschema %}
