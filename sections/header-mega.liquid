{%- comment -%}
  Standalone mega panel. The header's own mega panels (one per menu item with child links) are rendered
  inside the header section's nav, where `.dl-mega` is positioned; this section is not part of the header
  group. Added to a template it shows the same panel layout in the page flow: link columns from menus and
  featured product tiles. Shopify's wrapper carries the `dl-mega` class (schema), so the content starts at
  `.dl-mega-in`.
{%- endcomment -%}
{%- liquid
  assign scheme = section.settings.color_scheme | default: 'scheme-1'
  assign feature_max = section.settings.featured_count
  assign feature_count = 0
-%}
<div class="dl-mega-in {{ scheme }}" data-section="header-mega">
  {%- for block in section.blocks -%}
    {%- if block.type == 'column' -%}
      {%- if block.settings.heading != blank or block.settings.links.links.size > 0 -%}
        <div {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank %}<h3>{{ block.settings.heading | escape }}</h3>{% endif -%}
          {%- if block.settings.links.links.size > 0 -%}
            <ul>
              {%- for link in block.settings.links.links -%}
                <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
  {%- capture features -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'featured' and feature_count < feature_max -%}
        {%- if block.settings.product != blank or request.design_mode -%}
          {%- render 'header-mega-feature', product: block.settings.product, eyebrow: block.settings.badge, attrs: block.shopify_attributes -%}
          {%- assign feature_count = feature_count | plus: 1 -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- if features != blank %}<div class="grid g2" style="gap:12px">{{ features }}</div>{% endif -%}
</div>

{% stylesheet %}
  /* Shopify glue: as a template section the panel sits in the page flow instead of under the nav */
  div.shopify-section.dl-mega { position: relative; top: auto; z-index: auto; box-shadow: none; max-height: none; overflow: visible; }
{% endstylesheet %}

{% schema %}
{
  "name": "Header mega menu",
  "tag": "div",
  "class": "dl-mega",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "featured_count",
      "label": "Featured products",
      "default": 2,
      "min": 0,
      "max": 4,
      "step": 1
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Link column",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop by style"
        },
        {
          "type": "link_list",
          "id": "links",
          "label": "Links"
        }
      ]
    },
    {
      "type": "featured",
      "name": "Featured product",
      "limit": 4,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "default": "Most loved"
        }
      ]
    }
  ]
}
{% endschema %}
