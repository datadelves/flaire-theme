{%- liquid
  assign scheme = section.settings.color_scheme | default: 'scheme-1'
  assign show_date = true
  assign show_read_time = false
  assign ratio = '4:3'
  assign opts = section.blocks | where: 'type', 'article-options' | first
  if opts
    assign show_date = opts.settings.show_date
    assign show_read_time = opts.settings.show_read_time
    assign ratio = opts.settings.image_ratio
  endif
  assign empty_block = section.blocks | where: 'type', 'empty' | first
  assign promos = section.blocks | where: 'type', 'promo'
  assign current_tag = current_tags.first | handle
-%}
<div class="band {{ scheme }}" data-section="main-blog" style="{% render 'section-padding', top: section.settings.padding_top, bottom: section.settings.padding_bottom %}">
  <div class="wrap">
    {%- paginate blog.articles by section.settings.per_page -%}
      {%- if section.settings.show_tags and blog.all_tags.size > 0 -%}
        <div class="fc-chips" role="group" aria-label="{{ 'blogs.article.topics' | t }}" style="justify-content:center;margin-bottom:48px">
          <a class="fc-btn fc-btn-secondary fc-btn-sm" href="{{ blog.url }}"{% if current_tag == blank %} aria-current="true"{% endif %}>{{ 'blogs.all' | t }}</a>
          {%- for tag in blog.all_tags -%}
            {%- assign tag_handle = tag | handle -%}
            <a class="fc-btn fc-btn-secondary fc-btn-sm" href="{{ blog.url }}/tagged/{{ tag_handle }}"{% if current_tag == tag_handle %} aria-current="true" style="border-color:var(--action);color:var(--action)"{% endif %}>{{ tag | escape }}</a>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if blog.articles.size > 0 -%}
        <div class="grid g3 keep3" style="row-gap:48px" data-ratio="{{ ratio }}">
          {%- for article in blog.articles -%}
            {%- if section.settings.show_author or show_read_time -%}
              <div class="stack" style="gap:8px">
                {%- render 'article-card', article: article, show_excerpt: section.settings.show_excerpt, show_date: show_date -%}
                {%- liquid
                  assign meta = ''
                  if section.settings.show_author and article.author != blank
                    assign meta = 'blogs.article.by' | t: author: article.author
                  endif
                  if show_read_time
                    assign words = article.content | strip_html | split: ' ' | size
                    assign minutes = words | divided_by: 200 | at_least: 1
                    assign read = 'blogs.article.read_time' | t: minutes: minutes
                    if meta != blank
                      assign meta = meta | append: ' · ' | append: read
                    else
                      assign meta = read
                    endif
                  endif
                -%}
                {%- if meta != blank %}<p class="t-caption" style="margin:0">{{ meta }}</p>{% endif -%}
              </div>
            {%- else -%}
              {%- render 'article-card', article: article, show_excerpt: section.settings.show_excerpt, show_date: show_date -%}
            {%- endif -%}

            {%- comment -%} Inline promos sit after the third and sixth card of the first page. {%- endcomment -%}
            {%- if paginate.current_page == 1 -%}
              {%- assign promo_slot = forloop.index | divided_by: 3 | minus: 1 -%}
              {%- assign promo_mod = forloop.index | modulo: 3 -%}
              {%- if promo_mod == 0 and promos[promo_slot] -%}
                {%- assign promo = promos[promo_slot] -%}
                {%- if promo.settings.link != blank and promo.settings.headline != blank -%}
                  <a class="dl-acard" href="{{ promo.settings.link }}" {{ promo.shopify_attributes }}>
                    <div class="art">
                      {%- if promo.settings.image != blank -%}
                        {{- promo.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 1100px) 33vw, (min-width: 735px) 50vw, 100vw', alt: '', style: 'width:100%;height:100%;object-fit:cover' -}}
                      {%- else -%}
                        {%- render 'specimen', kind: 'band', metal: 'yellow-gold', size: 160, label: '' -%}
                      {%- endif -%}
                    </div>
                    <h3>{{ promo.settings.headline | escape }}</h3>
                  </a>
                {%- endif -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- render 'pagination', paginate: paginate -%}
      {%- elsif empty_block -%}
        {%- liquid
          assign empty_link_label = ''
          if empty_block.settings.link != blank
            assign empty_link_label = 'general.view_all' | t
          endif
        -%}
        <div {{ empty_block.shopify_attributes }}>
          {%- render 'empty-state', title: empty_block.settings.title, text: empty_block.settings.text, link_label: empty_link_label, link_url: empty_block.settings.link -%}
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% stylesheet %}
  .dl-main-blog [data-ratio="1:1"] .dl-acard .art { aspect-ratio: 1 / 1; }
{% endstylesheet %}

{% schema %}
{
  "name": "Article grid",
  "tag": "section",
  "class": "dl-section dl-main-blog",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1",
      "info": "Alternate schemes 1 and 2 down the page. Scheme 3 is dark."
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Articles per page",
      "default": 9,
      "min": 6,
      "max": 24,
      "step": 3
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Show tag filter row",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": false
    },
    {
      "type": "header",
      "content": "Section padding",
      "info": "Desktop sizes. Tablets, phones and Compact section spacing (Theme settings > Layout) scale them down in proportion."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 120,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 120,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "article-options",
      "name": "Card options",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_date",
          "label": "Show date",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_read_time",
          "label": "Show read time",
          "default": false
        },
        {
          "type": "select",
          "id": "image_ratio",
          "label": "Image ratio",
          "default": "4:3",
          "options": [
            {
              "value": "4:3",
              "label": "4:3"
            },
            {
              "value": "1:1",
              "label": "1:1"
            }
          ]
        }
      ]
    },
    {
      "type": "promo",
      "name": "Inline promo",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "headline",
          "label": "Headline",
          "default": "Engraved by hand"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "empty",
      "name": "Empty state",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "No articles yet"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Check back soon."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": [
      "blog"
    ]
  },
  "limit": 1
}
{% endschema %}
