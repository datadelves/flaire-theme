{%- liquid
  assign results = nil
  assign is_search = false
  if request.page_type == 'collection'
    assign results = collection
    assign action = collection.url
    assign count = collection.products_count
    assign clear_url = collection.url
    if collection.sort_by != blank
      assign clear_url = clear_url | append: '?sort_by=' | append: collection.sort_by
    endif
  elsif request.page_type == 'search' and search.performed
    assign results = search
    assign is_search = true
    assign action = routes.search_url
    assign count = search.results_count
    assign terms_q = search.terms | url_encode
    assign clear_url = routes.search_url | append: '?q=' | append: terms_q | append: '&options%5Bprefix%5D=last'
    assign types_joined = search.types | join: ','
    if search.types.size > 0
      assign clear_url = clear_url | append: '&type=' | append: types_joined
    endif
  endif

  if results
    assign current_sort = results.sort_by | default: results.default_sort_by
    if current_sort == blank
      if is_search
        assign current_sort = 'relevance'
      else
        assign current_sort = 'manual'
      endif
    endif
    if is_search
      assign sort_values = 'relevance,price-ascending,price-descending' | split: ','
    else
      assign sort_list = 'manual,best-selling'
      assign sort_list = sort_list | append: ',created-descending,price-ascending,price-descending,title-ascending'
      assign sort_values = sort_list | split: ','
    endif

    comment
      Param names of the filters the blocks render (collected as they render); every other filter (whatever
      Search & Discovery provides: availability, price, product type, vendor, variant options) gets its own
      group after the blocks.
    endcomment
    assign handled = '|'
  endif

  assign apply_text = section.settings.apply_label
  if apply_text contains '[count]'
    assign apply_text = apply_text | replace: '[count]', count
  else
    assign apply_text = 'products.facets.show_results' | t: count: count
  endif
  assign box = 'width:22px;height:22px;accent-color:var(--action)'
  assign row = 'display:flex;gap:12px;align-items:center;min-height:44px'
-%}
{%- if results -%}
  {%- if section.settings.desktop_drawer -%}
    <style>
      .dl-filters .group.d { display: none; }
      .dl-filters .dl-filter-m { display: inline-flex; }
      html.no-js .dl-filters .group.d { display: flex; }
    </style>
  {%- endif -%}
  <div class="app-ov" data-ov="filters" data-section-id="{{ section.id }}" hidden>
    <div class="dl-scrim" data-act="scrim"></div>
    <aside class="dl-drawer right scheme-1" data-place="right" data-place-mobile="bottom" role="dialog" aria-modal="true" aria-labelledby="ov-title-filters" data-ov-panel>
      <span class="dl-grab"></span>
      {%- assign drawer_title = 'products.facets.filter_and_sort' | t -%}
      {%- render 'drawer-head', title: drawer_title, id: 'ov-title-filters' -%}
      <form class="fd-form" action="{{ action }}" method="get" data-facets-form data-facets-deferred>
        {%- if is_search -%}
          <input type="hidden" name="q" value="{{ search.terms | escape }}">
          <input type="hidden" name="options[prefix]" value="last">
          {%- if search.types.size > 0 -%}<input type="hidden" name="type" value="{{ search.types | join: ',' }}">{%- endif -%}
        {%- endif -%}
        <div class="bd"><div class="stack-lg">
          <div><p class="t-title" style="margin:0 0 8px">{{ 'products.facets.sort' | t }}</p>
            {%- assign sort_in_list = false -%}
            {%- for sv in sort_values -%}
              {%- if sv == current_sort -%}{%- assign sort_in_list = true -%}{%- endif -%}
              <label style="{{ row }}"><input type="radio" name="sort_by" value="{{ sv }}"{% if sv == current_sort %} checked{% endif %} style="{{ box }}">{% render 'collection-facets-sort-name', value: sv, options: results.sort_options %}</label>
            {%- endfor -%}
            {%- unless sort_in_list -%}
              <label style="{{ row }}"><input type="radio" name="sort_by" value="{{ current_sort | escape }}" checked style="{{ box }}">{% render 'collection-facets-sort-name', value: current_sort, options: results.sort_options %}</label>
            {%- endunless -%}
          </div>

          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'facet-group' -%}
                {%- liquid
                  assign want = block.settings.filter_label | downcase | strip
                  assign group = nil
                  for filter in results.filters
                    assign have = filter.label | downcase | strip
                    if have == want and filter.type != 'price_range'
                      assign group = filter
                    endif
                  endfor
                -%}
                {%- if group and group.values.size > 0 -%}
                  {%- assign handled = handled | append: group.param_name | append: '|' -%}
                  <hr class="hr">
                  {%- capture group_body -%}
                    {%- if block.settings.style == 'chips' -%}
                      <div class="fc-chips">
                        {%- for value in group.values -%}
                          <label class="dl-chip{% if value.active %} is-on{% endif %}"><input type="checkbox" class="fc-sr" name="{{ value.param_name }}" value="{{ value.value | escape }}"{% if value.active %} checked{% endif %}><span>{{ value.label | escape }}{% if section.settings.show_counts %} <span class="muted">({{ value.count }})</span>{% endif %}</span></label>
                        {%- endfor -%}
                      </div>
                    {%- else -%}
                      {%- for value in group.values -%}
                        {%- if block.settings.style == 'swatch' -%}
                          {%- assign vh = value.label | handleize -%}
                          <label style="{{ row }}"><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}"{% if value.active %} checked{% endif %} style="{{ box }}"><span class="dot" style="width:22px;height:22px;border-radius:50%;background:var(--metal-{{ vh }}, var(--gem-{{ vh }}, {{ value.swatch.color | default: 'var(--hairline)' }}));box-shadow:inset 0 0 0 1px var(--hairline)"></span><span>{{ value.label | escape }}{% if section.settings.show_counts %} <span class="muted">({{ value.count }})</span>{% endif %}</span></label>
                        {%- else -%}
                          <label style="{{ row }}"><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}"{% if value.active %} checked{% endif %} style="{{ box }}">{{ value.label | escape }}</label>
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endif -%}
                  {%- endcapture -%}
                  {%- if block.settings.open -%}
                    <div {{ block.shopify_attributes }}>{%- if block.settings.filter_label != blank -%}<p class="t-title" style="margin:0 0 8px">{{ group.label | escape }}</p>{%- endif -%}{{ group_body }}</div>
                  {%- else -%}
                    <details class="fd-group" {{ block.shopify_attributes }}><summary class="t-title" style="margin:0 0 8px">{{ group.label | escape }}{% render 'icon', icon: 'caret-down', size: 16 %}</summary>{{ group_body }}</details>
                  {%- endif -%}
                {%- endif -%}

              {%- when 'price-range' -%}
                {%- liquid
                  assign price = nil
                  for filter in results.filters
                    if filter.type == 'price_range'
                      assign price = filter
                    endif
                  endfor
                -%}
                {%- if price and block.settings.show_inputs -%}
                  {%- liquid
                    assign min_v = ''
                    assign max_v = ''
                    if price.min_value.value != nil
                      assign rem = price.min_value.value | modulo: 100
                      if rem == 0
                        assign min_v = price.min_value.value | divided_by: 100
                      else
                        assign min_v = price.min_value.value | divided_by: 100.0
                      endif
                    endif
                    if price.max_value.value != nil
                      assign rem = price.max_value.value | modulo: 100
                      if rem == 0
                        assign max_v = price.max_value.value | divided_by: 100
                      else
                        assign max_v = price.max_value.value | divided_by: 100.0
                      endif
                    endif
                    assign label_from = 'products.facets.price_from' | t
                    assign label_to = 'products.facets.price_to' | t
                    assign any_ph = 'products.facets.price_any' | t | capitalize
                    assign handled = handled | append: price.param_name | append: '|'
                  -%}
                  <hr class="hr">
                  <div {{ block.shopify_attributes }}>
                    {%- if block.settings.label != blank %}<p class="t-title" style="margin:0 0 12px">{{ block.settings.label | escape }}</p>{% endif -%}
                    <div class="two" style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
                      {%- render 'field', label: label_from, name: price.min_value.param_name, id: 'fs-min', type: 'text', value: min_v, placeholder: '0', attrs: 'inputmode="decimal"' -%}
                      {%- render 'field', label: label_to, name: price.max_value.param_name, id: 'fs-max', type: 'text', value: max_v, placeholder: any_ph, attrs: 'inputmode="decimal"' -%}
                    </div>
                  </div>
                {%- endif -%}

              {%- when 'availability' -%}
                {%- liquid
                  assign stock_value = nil
                  assign engr_value = nil
                  for filter in results.filters
                    if filter.param_name == 'filter.v.availability'
                      for value in filter.values
                        if value.value == '1'
                          assign stock_value = value
                        endif
                      endfor
                    elsif filter.param_name == 'filter.p.m.custom.engravable'
                      if filter.type == 'boolean'
                        assign engr_value = filter.true_value
                      else
                        for value in filter.values
                          if value.value == '1' or value.value == 'true'
                            assign engr_value = value
                          endif
                        endfor
                      endif
                    endif
                  endfor
                  if block.settings.in_stock == blank
                    assign stock_value = nil
                  endif
                  if block.settings.engravable == blank
                    assign engr_value = nil
                  endif
                -%}
                {%- if stock_value or engr_value -%}
                  <hr class="hr">
                  <div class="stack" style="gap:12px" {{ block.shopify_attributes }}>
                    {%- if block.settings.label != blank %}<p class="t-title" style="margin:0">{{ block.settings.label | escape }}</p>{% endif -%}
                    {%- if stock_value -%}
                      {%- assign handled = handled | append: stock_value.param_name | append: '|' -%}
                      <label class="fc-check"><input type="checkbox" name="{{ stock_value.param_name }}" value="{{ stock_value.value | escape }}"{% if stock_value.active %} checked{% endif %}> {{ block.settings.in_stock | escape }}</label>
                    {%- endif -%}
                    {%- if engr_value -%}
                      {%- assign handled = handled | append: engr_value.param_name | append: '|' -%}
                      <label class="fc-check"><input type="checkbox" name="{{ engr_value.param_name }}" value="{{ engr_value.value | escape }}"{% if engr_value.active %} checked{% endif %}> {{ block.settings.engravable | escape }}</label>
                    {%- endif -%}
                  </div>
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}

          {%- for filter in results.filters -%}
            {%- assign f_key = '|' | append: filter.param_name | append: '|' -%}
            {%- if handled contains f_key -%}{%- continue -%}{%- endif -%}
            {%- if filter.type == 'price_range' -%}
              {%- liquid
                assign min_v = ''
                assign max_v = ''
                if filter.min_value.value != nil
                  assign min_v = filter.min_value.value | divided_by: 100.0
                  assign rem = filter.min_value.value | modulo: 100
                  if rem == 0
                    assign min_v = filter.min_value.value | divided_by: 100
                  endif
                endif
                if filter.max_value.value != nil
                  assign max_v = filter.max_value.value | divided_by: 100.0
                  assign rem = filter.max_value.value | modulo: 100
                  if rem == 0
                    assign max_v = filter.max_value.value | divided_by: 100
                  endif
                endif
                assign label_from = 'products.facets.price_from' | t
                assign label_to = 'products.facets.price_to' | t
                assign any_ph = 'products.facets.price_any' | t | capitalize
              -%}
              <hr class="hr">
              <div role="group" aria-labelledby="fd-{{ filter.param_name | handleize }}">
                <p class="t-title" id="fd-{{ filter.param_name | handleize }}" style="margin:0 0 12px">{{ filter.label | escape }}</p>
                <div class="two" style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
                  {%- render 'field', label: label_from, name: filter.min_value.param_name, id: 'fs-min', type: 'text', value: min_v, placeholder: '0', attrs: 'inputmode="decimal"' -%}
                  {%- render 'field', label: label_to, name: filter.max_value.param_name, id: 'fs-max', type: 'text', value: max_v, placeholder: any_ph, attrs: 'inputmode="decimal"' -%}
                </div>
              </div>
            {%- elsif filter.values.size > 0 -%}
              {%- liquid
                assign f_swatch = false
                if filter.param_name contains 'option.finish' or filter.presentation == 'swatch'
                  assign f_swatch = true
                endif
              -%}
              <hr class="hr">
              <details class="fd-group" open>
                <summary class="t-title" style="margin:0 0 8px">{{ filter.label | escape }}{% render 'icon', icon: 'caret-down', size: 16 %}</summary>
                {%- for value in filter.values -%}
                  <label style="{{ row }}"><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %} style="{{ box }}">
                    {%- if f_swatch -%}
                      {%- assign vh = value.label | handleize -%}
                      <span class="dot" style="width:22px;height:22px;border-radius:50%;background:var(--metal-{{ vh }}, var(--gem-{{ vh }}, {{ value.swatch.color | default: 'var(--hairline)' }}));box-shadow:inset 0 0 0 1px var(--hairline)"></span>
                    {%- endif -%}
                    <span>{{ value.label | escape }}{% if section.settings.show_counts %} <span class="muted">({{ value.count }})</span>{% endif %}</span></label>
                {%- endfor -%}
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div></div>
        <div class="ft">
          <button type="submit" class="fc-btn fc-btn-primary fc-btn-lg fc-btn-block" data-facets-count><span>{{ apply_text | escape }}</span></button>
          {%- if section.settings.clear_label != blank -%}
            <a class="fc-btn fc-btn-link no-chev" href="{{ clear_url }}" style="justify-self:center" data-act="facets-clear"><span>{{ section.settings.clear_label | escape }}</span></a>
          {%- endif -%}
        </div>
      </form>
    </aside>
  </div>
{%- endif -%}

{% stylesheet %}
  .app-ov[data-ov="filters"] .fd-form { display: contents; }
  .fd-group > summary { display: flex; justify-content: space-between; align-items: center; list-style: none; cursor: pointer; }
  .fd-group > summary::-webkit-details-marker { display: none; }
  .fd-group[open] > summary .dl-icon { transform: rotate(180deg); }
{% endstylesheet %}

{% schema %}
{
  "name": "Filters drawer",
  "tag": "section",
  "class": "dl-section dl-filters-drawer",
  "settings": [
    {
      "type": "checkbox",
      "id": "desktop_drawer",
      "label": "Use on desktop",
      "default": false
    },
    {
      "type": "text",
      "id": "apply_label",
      "label": "Apply label",
      "default": "Show results",
      "info": "Use [count] for the live result count, e.g. Show [count] results. Without [count] the button reads \"Show N results\"."
    },
    {
      "type": "text",
      "id": "clear_label",
      "label": "Clear label",
      "default": "Clear all"
    },
    {
      "type": "checkbox",
      "id": "show_counts",
      "label": "Show value counts",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "facet-group",
      "name": "Filter group",
      "settings": [
        {
          "type": "text",
          "id": "filter_label",
          "label": "Filter label",
          "default": "Finish"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "default": "swatch",
          "options": [
            {
              "value": "swatch",
              "label": "Material swatches"
            },
            {
              "value": "list",
              "label": "Checkbox list"
            },
            {
              "value": "chips",
              "label": "Chips"
            }
          ]
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Open by default",
          "default": true
        }
      ]
    },
    {
      "type": "price-range",
      "name": "Price range",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Price"
        },
        {
          "type": "checkbox",
          "id": "show_inputs",
          "label": "Show number fields",
          "default": true
        },
        {
          "type": "range",
          "id": "step",
          "label": "Price range step",
          "default": 50,
          "min": 10,
          "max": 500,
          "step": 10,
          "info": "In your store currency."
        }
      ]
    },
    {
      "type": "availability",
      "name": "Availability",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Availability"
        },
        {
          "type": "text",
          "id": "in_stock",
          "label": "In stock label",
          "default": "In stock"
        },
        {
          "type": "text",
          "id": "engravable",
          "label": "Engravable label",
          "default": "Engravable"
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": [
      "custom.overlay"
    ]
  },
  "limit": 1
}
{% endschema %}
