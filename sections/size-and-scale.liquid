  ],
  "blocks": [
    {
      "type": "measure",
      "name": "Measure",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Band width"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "2.1 mm"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Detail",
          "default": "Slim, sits flush with a wedding band."
        }
      ]
    },
    {
      "type": "tool",
      "name": "Tool",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "ruler",
          "options": [
            {
              "value": "ruler",
              "label": "Ruler"
            },
            {
              "value": "storefront",
              "label": "Visit"
            },
            {
              "value": "package",
              "label": "Free sizer"
            }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Printable ring sizer"
