{%- liquid
  assign s = section.settings
  assign scheme = s.color_scheme | default: 'scheme-2'
-%}
{%- capture measures -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'measure' and block.settings.label != blank -%}
      <div class="fc-fact" {{ block.shopify_attributes }}><dt>{{ block.settings.label | escape }}</dt><dd>{{ block.settings.value | escape }}{% if block.settings.detail != blank %}<span class="t-fine muted" style="display:block">{{ block.settings.detail | escape }}</span>{% endif %}</dd></div>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- capture tools -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'tool' and block.settings.title != blank -%}
      {%- capture tool_attrs %}{{ block.shopify_attributes }}{% endcapture -%}
      {%- if block.settings.link contains 'size-guide' and block.settings.link contains '#' -%}
        {%- capture tool_attrs %}data-open="size-guide" data-tab="rings" {{ block.shopify_attributes }}{% endcapture -%}
        {%- render 'button', variant: 'link', label: block.settings.title, icon: block.settings.icon, no_chev: true, attrs: tool_attrs -%}
      {%- elsif block.settings.link != blank -%}
        {%- render 'button', variant: 'link', label: block.settings.title, icon: block.settings.icon, url: block.settings.link, attrs: tool_attrs -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
<div class="band {{ scheme }}" data-section="size-and-scale" style="{% render 'section-padding', top: section.settings.padding_top, bottom: section.settings.padding_bottom %}"><div class="wrap split">
  <div class="dl-scale">
    {%- if s.image != blank -%}
      {%- liquid
        assign fit_class = 'dl-scale-img'
        if s.image_fit == 'cover'
          assign fit_class = 'dl-scale-img is-cover'
        endif
      -%}
      {{ s.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1200', sizes: '(max-width: 734px) 100vw, 50vw', alt: s.image_alt, class: fit_class }}
    {%- else -%}
      {%- render 'specimen', kind: 'ring', metal: 'rose-gold', gem: 'diamond', size: 280, label: s.image_alt -%}
      <div class="ruler"><span>0</span><span>10 mm</span><span>20 mm</span></div>
    {%- endif -%}
  </div>
  <div class="stack-lg">
    {%- render 'section-head', eyebrow: s.eyebrow, heading: s.headline, sub: s.sub, left: true -%}
    {%- if measures != blank %}<dl class="fc-facts">{{ measures }}</dl>{% endif -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'fit-note' -%}
        {%- if block.settings.title != blank or block.settings.text != blank -%}
          {%- capture note_attrs %}{{ block.shopify_attributes }}{% endcapture -%}
          {%- render 'notice', tone: block.settings.tone, title: block.settings.title, text: block.settings.text, attrs: note_attrs -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if tools != blank %}<div class="inline" style="gap:20px">{{ tools }}</div>{% endif -%}
    {%- liquid
      assign show_link = false
      if s.link_label != blank and s.link != blank
        assign show_link = true
      endif
    -%}
    {%- if s.cta_label != blank or show_link -%}
      <div class="inline" style="gap:20px">
        {%- if s.cta_label != blank -%}
          {%- if s.cta_link != blank -%}
            {%- render 'button', label: s.cta_label, size: 'lg', url: s.cta_link -%}
          {%- else -%}
            {%- capture guide_attrs %}data-open="size-guide" data-tab="{{ s.size_guide_tab | default: 'rings' }}"{% endcapture -%}
            {%- render 'button', label: s.cta_label, size: 'lg', attrs: guide_attrs -%}
          {%- endif -%}
        {%- endif -%}
        {%- if show_link %}{% render 'button', variant: 'link', label: s.link_label, url: s.link %}{% endif -%}
      </div>
    {%- endif -%}
  </div>
</div></div>

{% stylesheet %}
  /* Show the whole image: the frame takes the photo's height. Fill the frame: the 4:5 frame, cropped. */
  .dl-scale:has(> .dl-scale-img:not(.is-cover)) { aspect-ratio: auto; align-self: center; }
  .dl-scale .dl-scale-img { display: block; width: 100%; height: auto; padding: var(--space-6); box-sizing: border-box; }
  .dl-scale .dl-scale-img.is-cover { position: absolute; inset: 0; height: 100%; object-fit: cover; padding: 0; }
  .dl-scale > svg.fc-spec { width: min(280px, 60%); height: auto; }
{% endstylesheet %}

{% schema %}
{
  "name": "Size and scale",
  "tag": "section",
  "class": "dl-section dl-size-and-scale",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Fit"
