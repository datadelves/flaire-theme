    {
      "type": "inline_richtext",
      "id": "headline",
      "label": "Headline",
      "default": "Know it fits before it arrives"
    },
    {
      "type": "inline_richtext",
      "id": "sub",
      "label": "Supporting line",
      "default": "Real dimensions, drawn to scale."
    },
    {
      "type": "color_scheme",
