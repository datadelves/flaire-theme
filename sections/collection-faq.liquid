{%- liquid
  assign scheme = section.settings.color_scheme | default: 'scheme-2'
  assign opened = false
  assign learn_more = 'general.learn_more' | t
-%}
<div class="band tight {{ scheme }}" data-section="collection-faq" style="{% render 'section-padding', top: section.settings.padding_top, bottom: section.settings.padding_bottom, fixed: true %}">
  <div class="wrap-n">
    {%- render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.headline, sub: section.settings.sub, role: 't-title-lg' -%}
    <div class="fc-acc"{% if section.settings.single_open %} data-acc-single{% endif %}>
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'faq' -%}
            {%- assign answer_check = block.settings.answer | strip_html | strip -%}
            {%- if block.settings.title != blank and answer_check != blank -%}
              <details class="fc-acc-item"{% unless opened %} open{% endunless %} {{ block.shopify_attributes }}>
                <summary class="fc-acc-btn"><span>{{ block.settings.title | escape }}</span>{% render 'icon', icon: 'plus', size: 20, class: 'fc-acc-ico-plus' %}{% render 'icon', icon: 'minus', size: 20, class: 'fc-acc-ico-minus' %}</summary>
                <div class="fc-acc-panel" role="region">
                  {{- block.settings.answer -}}
                  {%- if block.settings.link != blank -%}<p>{% render 'button', variant: 'link', label: learn_more, url: block.settings.link %}</p>{%- endif -%}
                </div>
              </details>
              {%- assign opened = true -%}
            {%- endif -%}
          {%- when 'policy' -%}
            {%- if block.settings.title != blank and block.settings.page != blank -%}
              {%- assign policy_page = block.settings.page -%}
              <details class="fc-acc-item" {{ block.shopify_attributes }}>
                <summary class="fc-acc-btn"><span>{{ block.settings.title | escape }}</span>{% render 'icon', icon: 'plus', size: 20, class: 'fc-acc-ico-plus' %}{% render 'icon', icon: 'minus', size: 20, class: 'fc-acc-ico-minus' %}</summary>
                <div class="fc-acc-panel" role="region">
                  {%- if block.settings.text != blank %}<p>{{ block.settings.text | escape }}</p>{% endif -%}
                  {%- assign policy_label = policy_page.title | escape -%}
                  <p>{% render 'button', variant: 'link', label: policy_label, url: policy_page.url %}</p>
                </div>
              </details>
            {%- endif -%}
          {%- when 'contact' -%}
            {%- if block.settings.title != blank and block.settings.link != blank -%}
              <div class="fc-acc-item" {{ block.shopify_attributes }}>
                <a class="fc-acc-btn" href="{{ block.settings.link }}"><span class="cf-contact">{% render 'icon', icon: block.settings.icon, size: 20 %}{{ block.settings.title | escape }}</span>{% render 'icon', icon: 'caret-right', size: 20 %}</a>
              </div>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .cf-contact { display: inline-flex; align-items: center; gap: var(--space-3); }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection questions",
  "tag": "section",
  "class": "dl-section dl-collection-faq",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Help"
    },
    {
      "type": "inline_richtext",
      "id": "headline",
      "label": "Headline",
      "default": "Before you choose"
    },
    {
      "type": "inline_richtext",
      "id": "sub",
      "label": "Supporting line"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2",
      "info": "Alternate schemes 1 and 2 down the page. Scheme 3 is dark."
    },
    {
      "type": "checkbox",
      "id": "single_open",
      "label": "One open at a time",
      "default": true
    },
    {
      "type": "header",
      "content": "Section padding",
      "info": "The same on every screen size."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 64,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 64,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Question",
          "default": "How wide is the band?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>2.1 mm.</p>"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "contact",
      "name": "Contact",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Ask a jeweler"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "chat-circle-dots",
          "options": [
            {
              "value": "chat-circle-dots",
              "label": "Chat"
            },
            {
              "value": "envelope-simple",
              "label": "Mail"
            }
          ]
        }
      ]
    },
    {
      "type": "policy",
      "name": "Policy",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Returns"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Page"
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": [
      "collection"
    ]
  },
  "presets": [
    {
      "name": "Collection questions",
      "blocks": [
        {
          "type": "faq"
        },
        {
          "type": "faq"
        },
        {
          "type": "faq"
        },
        {
          "type": "faq"
        },
        {
          "type": "contact"
        },
        {
          "type": "contact"
        },
        {
          "type": "policy"
        },
        {
          "type": "policy"
        },
        {
          "type": "policy"
        }
      ]
    }
  ]
}
{% endschema %}
