{%- liquid
  assign scheme = section.settings.color_scheme | default: 'scheme-2'
  assign active_labels = ''
  for filter in collection.filters
    if filter.param_name contains 'option.finish' or filter.param_name == 'filter.p.m.custom.stone'
      assign joined = filter.active_values | map: 'label' | join: '|' | downcase
      assign active_labels = active_labels | append: '|' | append: joined
    endif
  endfor
  assign active_labels = active_labels | split: '|'
  assign guide = section.blocks | where: 'type', 'guide-link' | first
-%}
<div class="band tight {{ scheme }}" data-section="collection-material-guide" style="{% render 'section-padding', top: section.settings.padding_top, bottom: section.settings.padding_bottom, fixed: true %}">
  <div class="wrap">
    {%- render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.headline, sub: section.settings.sub -%}
    <div class="{% if section.settings.layout == 'tiles' %}grid g4 cmg-tiles{% else %}fc-chips{% endif %}"{% if section.settings.layout != 'tiles' %} style="justify-content:center"{% endif %}>
      {%- for block in section.blocks -%}
        {%- liquid
          if block.type == 'guide-link'
            continue
          endif
          if block.type == 'metal-link'
            assign key = block.settings.metal
            assign dot = 'var(--metal-' | append: key | append: ')'
            case key
              when 'yellow-gold'
                assign label = 'Yellow Gold'
              when 'rose-gold'
                assign label = 'Rose Gold'
              when 'white-gold'
                assign label = 'White Gold'
              else
                assign label = 'Platinum'
            endcase
            assign param = 'filter.v.option.finish='
          else
            assign key = block.settings.stone
            assign dot = 'var(--gem-' | append: key | append: ')'
            assign label = key | capitalize
            assign param = 'filter.p.m.custom.stone='
          endif
          assign href = block.settings.link
          if href == blank and collection.url != blank
            assign href = collection.url | append: '?' | append: param
            assign encoded = label | url_encode
            assign href = href | append: encoded
          endif
          assign label_down = label | downcase
          assign is_on = false
          if active_labels contains label_down
            assign is_on = true
          endif
        -%}
        {%- if href != blank -%}
          {%- if section.settings.layout == 'tiles' -%}
            <a class="dl-tile-card{% if is_on %} is-on{% endif %}" href="{{ href }}"{% if is_on %} aria-current="true"{% endif %} {{ block.shopify_attributes }}><span class="dot" style="width:22px;height:22px;border-radius:50%;background:{{ dot }};box-shadow:inset 0 0 0 1px var(--hairline)"></span><span class="t-title">{{ label }}</span>{% if block.settings.line != blank %}<span class="t-caption">{{ block.settings.line | escape }}</span>{% endif %}</a>
          {%- else -%}
            <a class="dl-chip{% if is_on %} is-on{% endif %}" href="{{ href }}"{% if is_on %} aria-current="true"{% endif %} {{ block.shopify_attributes }}><span class="dot" style="background:{{ dot }}"></span><span>{{ label }}</span>{% if block.settings.line != blank %}<span class="muted">{{ block.settings.line | escape }}</span>{% endif %}</a>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if guide and guide.settings.label != blank and guide.settings.link != blank -%}
      <div style="text-align:center;margin-top:32px" {{ guide.shopify_attributes }}>
        {%- assign guide_label = guide.settings.label | escape -%}
        {%- render 'button', variant: 'link', label: guide_label, url: guide.settings.link -%}
        {%- if guide.settings.note != blank %}<p class="t-caption" style="margin:8px 0 0">{{ guide.settings.note | escape }}</p>{% endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .cmg-tiles .dl-tile-card { justify-content: flex-start; color: var(--ink); min-height: 0; }
  @media (max-width: 734px) {
    [data-section="collection-material-guide"] .fc-chips { flex-wrap: nowrap; justify-content: flex-start !important; overflow-x: auto; scrollbar-width: none; margin: 0 calc(-1 * var(--space-5)); padding: 0 var(--space-5); }
    [data-section="collection-material-guide"] .fc-chips::-webkit-scrollbar { display: none; }
    [data-section="collection-material-guide"] .fc-chips > * { flex: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop by material",
  "tag": "section",
  "class": "dl-section dl-collection-material-guide",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Materials"
    },
    {
      "type": "inline_richtext",
      "id": "headline",
      "label": "Headline",
      "default": "Start with the metal"
    },
    {
      "type": "inline_richtext",
      "id": "sub",
      "label": "Supporting line"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2",
      "info": "Alternate schemes 1 and 2 down the page. Scheme 3 is dark."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "chips",
      "options": [
        {
          "value": "chips",
          "label": "Pill chips with swatch"
        },
        {
          "value": "tiles",
          "label": "Tiles with close-up image"
        }
      ]
    },
    {
      "type": "header",
      "content": "Section padding",
      "info": "The same on every screen size."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 64,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 64,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "metal-link",
      "name": "Metal link",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "metal",
          "label": "Metal",
          "default": "rose-gold",
          "options": [
            {
              "value": "yellow-gold",
              "label": "Yellow gold"
            },
            {
              "value": "rose-gold",
              "label": "Rose gold"
            },
            {
              "value": "white-gold",
              "label": "White gold"
            },
            {
              "value": "platinum",
              "label": "Platinum"
            }
          ]
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "line",
          "label": "Line",
          "default": "18-karat"
        }
      ]
    },
    {
      "type": "stone-link",
      "name": "Stone link",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "stone",
          "label": "Stone",
          "default": "diamond",
          "options": [
            {
              "value": "diamond",
              "label": "Diamond"
            },
            {
              "value": "sapphire",
              "label": "Sapphire"
            },
            {
              "value": "emerald",
              "label": "Emerald"
            },
            {
              "value": "ruby",
              "label": "Ruby"
            },
            {
              "value": "pearl",
              "label": "Pearl"
            },
            {
              "value": "onyx",
              "label": "Onyx"
            }
          ]
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "line",
          "label": "Line"
        }
      ]
    },
    {
      "type": "guide-link",
      "name": "Guide link",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Materials guide"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Note"
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": [
      "collection"
    ]
  },
  "presets": [
    {
      "name": "Shop by material",
      "blocks": [
        {
          "type": "metal-link"
        },
        {
          "type": "metal-link"
        },
        {
          "type": "metal-link"
        },
        {
          "type": "metal-link"
        },
        {
          "type": "stone-link"
        },
        {
          "type": "stone-link"
        },
        {
          "type": "stone-link"
        },
        {
          "type": "stone-link"
        },
        {
          "type": "guide-link"
        }
      ]
    }
  ]
}
{% endschema %}
