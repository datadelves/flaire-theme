{%- liquid
  assign scheme = section.settings.color_scheme | default: 'scheme-2'
  assign c = collection
  if c == blank
    assign c = collections['rings']
  endif
  if c == blank
    assign c = collections.all
  endif

  assign desc = c.description | strip_html | strip

  assign art = blank
  if section.settings.show_image
    if c.image != blank
      assign art = c.image
    elsif c.products.first.featured_media != blank
      assign art = c.products.first.featured_media
    endif
  endif
  assign first_product = c.products.first
  capture first_kind
    render 'product-data', product: first_product, field: 'kind'
  endcapture
  assign first_kind = first_kind | strip | default: 'ring'

  assign guide = ''
  if section.settings.show_size_guide
    capture guide
      render 'product-data', product: first_product, field: 'guide'
    endcapture
    assign guide = guide | strip
  endif
  case guide
    when 'rings'
      assign guide_label = 'products.facets.ring_guide' | t
    when 'necklaces'
      assign guide_label = 'products.facets.chain_guide' | t
    when 'bracelets'
      assign guide_label = 'products.facets.bracelet_guide' | t
    else
      assign guide = ''
  endcase
  assign guide_url = pages['ring-sizing'].url

  assign fact_blocks = section.blocks | where: 'type', 'fact'
  assign sub_blocks = section.blocks | where: 'type', 'sub-collection'
  assign crumb_block = section.blocks | where: 'type', 'breadcrumb' | first
-%}
<div data-section="collection-hero">
  <div class="fc-tile {{ scheme }}{% if art == blank and request.design_mode == false %} nopad-b{% endif %}" style="{% render 'section-padding', top: section.settings.padding_top, bottom: section.settings.padding_bottom %}">
    <div class="fc-tile-copy">
      {%- if crumb_block -%}
        <div class="coll-hero-crumb{% if crumb_block.settings.compact %} is-compact{% endif %}" {{ crumb_block.shopify_attributes }}>
          {%- render 'breadcrumb' -%}
        </div>
      {%- endif -%}
      {%- if section.settings.eyebrow != blank -%}
        <p class="fc-tile-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.show_title -%}
        <h1 class="t-hero"><span>{{ c.title | escape }}</span></h1>
      {%- endif -%}
      {%- if section.settings.show_description and desc != blank -%}
        <div class="fc-tile-sub rte coll-hero-desc">{{ c.description }}</div>
      {%- endif -%}
      {%- if section.settings.show_count or fact_blocks.size > 0 -%}
        <div class="facts">
          {%- if section.settings.show_count -%}
            <span class="fc-badge fc-badge-neutral">{{ 'general.pieces' | t: count: c.all_products_count }}</span>
          {%- endif -%}
          {%- for block in fact_blocks -%}
            {%- if block.settings.label != blank -%}
              {%- if block.settings.link != blank -%}
                <a class="fc-badge fc-badge-neutral" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}{% if block.settings.detail != blank %}<span class="fc-sr"> {{ block.settings.detail | escape }}</span>{% endif %}</a>
              {%- else -%}
                <span class="fc-badge fc-badge-neutral" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}{% if block.settings.detail != blank %}<span class="fc-sr"> {{ block.settings.detail | escape }}</span>{% endif %}</span>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- if sub_blocks.size > 0 -%}
        <nav class="fc-chips coll-hero-subs" aria-label="{{ c.title | escape }}">
          {%- for block in sub_blocks -%}
            {%- assign sub = block.settings.collection -%}
            {%- if sub != blank -%}
              {%- assign sub_label = block.settings.label | default: sub.title -%}
              {%- assign is_current = false -%}
              {%- if block.settings.current or sub.handle == collection.handle -%}{%- assign is_current = true -%}{%- endif -%}
              <a class="dl-chip sm{% if is_current %} is-on{% endif %}" href="{{ sub.url }}"{% if is_current %} aria-current="page"{% endif %} {{ block.shopify_attributes }}>{{ sub_label | escape }}</a>
            {%- elsif request.design_mode -%}
              <span class="dl-chip sm" {{ block.shopify_attributes }}>{{ block.settings.label | default: 'Bands' | escape }}</span>
            {%- endif -%}
          {%- endfor -%}
        </nav>
      {%- endif -%}
      {%- if guide != blank or section.settings.link_label != blank and section.settings.link != blank -%}
        <div class="fc-tile-actions">
          {%- if guide != blank -%}
            {%- capture guide_attrs -%}data-open="size-guide" data-tab="{{ guide }}"{%- endcapture -%}
            {%- render 'button', variant: 'link', label: guide_label, url: guide_url, attrs: guide_attrs -%}
          {%- endif -%}
          {%- if section.settings.link_label != blank and section.settings.link != blank -%}
            {%- assign link_label = section.settings.link_label | escape -%}
            {%- render 'button', variant: 'link', label: link_label, url: section.settings.link -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
    {%- if art != blank -%}
      <div class="fc-tile-art"><div class="hero-art" style="aspect-ratio:16/6">
        {%- render 'product-photo', image: art, size: 400, alt: c.title, loading: 'eager', fetchpriority: 'high', sizes: '(max-width: 734px) 70vw, 400px', kind: first_kind -%}
      </div></div>
    {%- elsif request.design_mode and section.settings.show_image -%}
      <div class="fc-tile-art"><div class="hero-art" style="aspect-ratio:16/6">
        {%- render 'specimen', kind: first_kind, metal: 'yellow-gold', gem: 'sapphire', size: 400, label: '' -%}
      </div></div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .coll-hero-crumb { margin-bottom: var(--space-4); }
  .coll-hero-crumb .dl-crumb { justify-content: center; }
  .coll-hero-subs { justify-content: center; margin-top: var(--space-4); }
  /* the full collection description (merchant rich text) keeps the one-line sub's type */
  .fc-tile-sub.coll-hero-desc > * { margin: 0; }
  .fc-tile-sub.coll-hero-desc > * + * { margin-top: var(--space-3); }
  @media (max-width: 734px) {
    .coll-hero-crumb.is-compact .dl-crumb > [aria-current],
    .coll-hero-crumb.is-compact .dl-crumb > svg:last-of-type { display: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection hero",
  "tag": "section",
  "class": "dl-section dl-collection-hero",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show collection title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show image",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2",
      "info": "Alternate schemes 1 and 2 down the page. Scheme 3 is dark."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Collection"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "show_size_guide",
      "label": "Show size guide link",
      "default": true,
      "info": "Opens the size guide tab that matches the first product's type (rings, necklaces or bracelets)."
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show piece count",
      "default": true
    },
    {
      "type": "header",
      "content": "Section padding",
      "info": "Desktop sizes. Tablets, phones and Compact section spacing (Theme settings > Layout) scale them down in proportion."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 120,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 0,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "info": "Without an image, at least the top padding."
    }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "18-karat gold"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Detail"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "breadcrumb",
      "name": "Breadcrumb",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_home",
          "label": "Show home link",
          "default": true
        },
        {
          "type": "text",
          "id": "separator_label",
          "label": "Accessible label",
          "default": "Breadcrumb"
        },
        {
          "type": "checkbox",
          "id": "compact",
          "label": "Compact on mobile",
          "default": true
        }
      ]
    },
    {
      "type": "sub-collection",
      "name": "Sub-collection link",
      "limit": 8,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "checkbox",
          "id": "current",
          "label": "Mark as current page",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection hero",
      "blocks": [
        {
          "type": "fact"
        },
        {
          "type": "fact"
        },
        {
          "type": "fact"
        },
        {
          "type": "fact"
        },
        {
          "type": "breadcrumb"
        },
        {
          "type": "sub-collection"
        },
        {
          "type": "sub-collection"
        },
        {
          "type": "sub-collection"
        },
        {
          "type": "sub-collection"
        }
      ]
    }
  ]
}
{% endschema %}
