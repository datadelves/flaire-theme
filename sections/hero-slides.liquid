{%- liquid
  assign scheme = section.settings.color_scheme | default: 'scheme-1'
  assign slide_count = section.blocks.size
  assign autoplay = section.settings.autoplay
  assign interval_ms = section.settings.interval_seconds | times: 1000
-%}
{%- if slide_count > 0 -%}
  {%- capture slides_html -%}
    {%- for block in section.blocks -%}
      {%- liquid
        assign b = block.settings
        assign tone = b.color_scheme | default: 'scheme-1'
        if b.tint != blank and b.tint != 'none'
          assign tone = tone | append: ' ' | append: b.tint
        endif
        assign heading_tag = 'h2'
        if forloop.first and section.index == 1
          assign heading_tag = 'h1'
        endif
        assign first_slide = forloop.first
        assign slide_of = 'accessibility.slide_of' | t: index: forloop.index, count: slide_count
      -%}
      <div class="hs-slide {{ tone }}{% if forloop.first %} is-on{% endif %}" role="group" aria-roledescription="slide" aria-label="{{ slide_of }}" data-slide="{{ forloop.index0 }}"{% unless forloop.first %} aria-hidden="true" inert{% endunless %} {{ block.shopify_attributes }}>
        <div class="hs-in">
          <div class="hs-copy">
            {%- if b.eyebrow != blank %}<p class="fc-tile-eyebrow">{{ b.eyebrow | escape }}</p>{% endif -%}
            {%- if b.heading != blank %}<{{ heading_tag }} class="t-hero">{{ b.heading | escape }}</{{ heading_tag }}>{% endif -%}
            {%- if b.subheading != blank %}<p class="fc-tile-sub">{{ b.subheading | escape }}</p>{% endif -%}
            {%- liquid
              assign show_cta = false
              if b.cta_label != blank and b.cta_url != blank
                assign show_cta = true
              endif
              assign show_link = false
              if b.link_label != blank and b.link_url != blank
                assign show_link = true
              endif
            -%}
            {%- if show_cta or show_link -%}
              <div class="fc-tile-actions">
                {%- if show_cta -%}
                  {%- render 'button', label: b.cta_label, size: 'lg', url: b.cta_url -%}
                {%- endif -%}
                {%- if show_link -%}
                  {%- render 'button', variant: 'link', label: b.link_label, url: b.link_url -%}
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
          <div class="hs-art" aria-hidden="true">
            {%- for slot in (1..3) -%}
              {%- liquid
                case slot
                  when 1
                    assign slot_image = b.image_left
                    assign slot_product = b.product_left
                    assign slot_class = 'p-l'
                    if b.flat_left
                      assign slot_class = 'p-l p-flat'
                    endif
                    assign slot_metal = 'white-gold'
                    assign slot_sizes = '(max-width: 734px) 40vw, 320px'
                  when 2
                    assign slot_image = b.image
                    assign slot_product = b.product
                    assign slot_class = 'p-c'
                    assign slot_metal = 'rose-gold'
                    assign slot_sizes = '(max-width: 734px) 60vw, 480px'
                  else
                    assign slot_image = b.image_right
                    assign slot_product = b.product_right
                    assign slot_class = 'p-r'
                    if b.flat_right
                      assign slot_class = 'p-r p-flat'
                    endif
                    assign slot_metal = 'yellow-gold'
                    assign slot_sizes = '(max-width: 734px) 40vw, 320px'
                endcase
                assign art = slot_image
                if art == blank and slot_product != blank
                  assign art = slot_product.featured_media
                endif
                assign slot_kind = 'ring'
                if slot_product != blank
                  capture slot_kind
                    render 'product-data', product: slot_product, field: 'kind'
                  endcapture
                  assign slot_kind = slot_kind | strip | default: 'ring'
                endif
                assign slot_loading = 'lazy'
                assign slot_priority = ''
                if first_slide and section.index == 1
                  assign slot_loading = 'eager'
                  if slot == 2
                    assign slot_priority = 'high'
                  endif
                endif
              -%}
              {%- render 'product-photo', image: art, size: 640, alt: '', class: slot_class, loading: slot_loading, fetchpriority: slot_priority, sizes: slot_sizes, kind: slot_kind, metal: slot_metal -%}
            {%- endfor -%}
            {%- if b.chip != blank %}<span class="hs-chip">{{ b.chip | escape }}</span>{% endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  {%- endcapture -%}
  <div class="hs {{ scheme }}" data-section="hero-slides" data-pad style="{% render 'section-padding', top: section.settings.padding_top, bottom: section.settings.padding_bottom %}" data-hs data-autoplay="{{ autoplay }}" data-interval="{{ interval_ms }}" aria-roledescription="carousel" aria-label="{{ 'accessibility.slideshow' | t }}">
    <div class="hs-track" aria-live="{% if autoplay %}off{% else %}polite{% endif %}">{{ slides_html }}</div>
    {%- if slide_count > 1 -%}
      <div class="hs-ctl"><div class="hs-ctl-in"><div class="hs-bars" role="group" aria-label="{{ 'accessibility.choose_slide' | t }}">
        {%- for block in section.blocks -%}
          {%- liquid
            assign tag = block.settings.tag | default: block.settings.heading | default: block.settings.eyebrow
            assign bar_label = 'accessibility.slide_label' | t: index: forloop.index, title: tag
          -%}
          <button type="button" data-block="slide" class="hs-bar{% if forloop.first %} is-on{% endif %}" data-act="hs-go" data-i="{{ forloop.index0 }}" aria-label="{{ bar_label | escape }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"><span class="hs-bar-n" aria-hidden="true"></span><span class="hs-bar-t">{{ tag | escape }}</span><span class="hs-bar-line"><i></i></span></button>
        {%- endfor -%}
        </div><div class="hs-btns">
          {%- if autoplay -%}
            <button type="button" class="fc-btn fc-btn-icon" data-act="hs-toggle" aria-label="{{ 'accessibility.pause_slideshow' | t }}">{% render 'icon', icon: 'pause', size: 20 %}</button>
          {%- else -%}
            <button type="button" class="fc-btn fc-btn-icon" data-act="hs-toggle" aria-label="{{ 'accessibility.play_slideshow' | t }}">{% render 'icon', icon: 'play', size: 20 %}</button>
          {%- endif -%}
          <button type="button" class="fc-btn fc-btn-icon" data-act="hs-prev" aria-label="{{ 'accessibility.previous_slide' | t }}">{% render 'icon', icon: 'caret-left', size: 20 %}</button><button type="button" class="fc-btn fc-btn-icon" data-act="hs-next" aria-label="{{ 'accessibility.next_slide' | t }}">{% render 'icon', icon: 'caret-right', size: 20 %}</button>
        </div></div></div>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  /* placeholder art (specimen SVG) sits where the prototype's photos sit */
  .hs-art svg.fc-spec { position: absolute; height: auto; max-width: none; opacity: 0; transition: opacity .8s var(--fc-ease), transform 1s var(--fc-ease); }
  /* single-slide hero: no control bar */
  .hs-track:only-child .hs-in { padding-bottom: 56px; }
  /* performance: the hidden slides' photos (absolutely placed, so no layout change) stay unloaded until the
     page has loaded and the kernel marks the slideshow ready, so they never compete with the first slide */
  .hs:not(.is-ready) .hs-slide:not(.is-on) .hs-art > img { display: none; }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero slideshow",
  "tag": "section",
  "class": "dl-section hs",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "interval_seconds",
      "label": "Advance every",
      "default": 6,
      "min": 4,
      "max": 12,
      "step": 0.5,
      "unit": "s"
    },
    {
      "type": "header",
      "content": "Section padding",
      "info": "Desktop sizes. Tablets, phones and Compact section spacing (Theme settings > Layout) scale them down in proportion."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 0,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 0,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "limit": 4,
      "settings": [
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "Color scheme",
          "default": "scheme-1"
        },
        {
          "type": "select",
          "id": "tint",
          "label": "Tint",
          "default": "none",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "tint-sand",
              "label": "Sand"
            },
            {
              "value": "tint-mist",
              "label": "Mist"
            }
          ]
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Progress bar label",
          "info": "Short name under the slide's progress bar. Empty uses the heading."
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "New collection"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Light, held."
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "Set by hand in 18-karat gold and platinum."
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button label",
          "default": "Shop the collection"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "Button link"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Learn about materials"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link"
        },
        {
          "type": "header",
          "content": "Art"
        },
        {
          "type": "paragraph",
          "content": "Up to three cut-out photos. Each uses its image, else the product's featured image, else a placeholder."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image_left",
          "label": "Left image"
        },
        {
          "type": "product",
          "id": "product_left",
          "label": "Left product"
        },
        {
          "type": "checkbox",
          "id": "flat_left",
          "label": "Lay left piece flat",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "image_right",
          "label": "Right image"
        },
        {
          "type": "product",
          "id": "product_right",
          "label": "Right product"
        },
        {
          "type": "checkbox",
          "id": "flat_right",
          "label": "Lay right piece flat",
          "default": false
        },
        {
          "type": "text",
          "id": "chip",
          "label": "Engraving chip",
          "info": "Words set in the engraving face over the art, e.g. Always, M."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero slideshow",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
