{%- capture base_id -%}{% render 'product-base-variant', product: product, prefer_available: true %}{%- endcapture -%}
{%- liquid
  assign base_id = base_id | strip
  assign base = product.selected_or_first_available_variant
  for v in product.variants
    assign vid = v.id | append: ''
    if vid == base_id
      assign base = v
      break
    endif
  endfor
-%}
{%- liquid
  assign scheme = section.settings.color_scheme | default: 'scheme-1'
  assign form_id = 'product-form-' | append: section.id
  assign finish_index = -1
  assign other_option = false
  for option in product.options_with_values
    assign option_name = option.name | downcase
    if option_name == 'finish' or option_name == 'metal'
      assign finish_index = forloop.index0
    else
      assign other_option = true
    endif
  endfor
  if product.has_only_default_variant
    assign other_option = false
  endif
  assign base = base
  assign selected_variant = product.selected_variant
  if selected_variant == blank and other_option == false
    assign selected_variant = base
  endif
  assign finish = ''
  if finish_index >= 0
    assign finish = base.options[finish_index]
  endif

  assign has_buy = false
  assign availability_block = nil
  assign gift_block = nil
  for block in section.blocks
    case block.type
      when 'buy-buttons'
        assign has_buy = true
      when 'availability'
        assign availability_block = block
      when 'gift-note'
        assign gift_block = block
    endcase
  endfor
  assign stock_text = availability_block.settings.delivery_text | default: ''

  assign price_block = section.blocks | where: 'type', 'price' | first
  assign financing_note = price_block.settings.financing_note
  assign financing_min = price_block.settings.financing_min | default: 600 | times: 100
-%}
<div class="band {{ scheme }}" data-section="main-product" style="{% render 'section-padding', top: section.settings.padding_top, bottom: section.settings.padding_bottom, fixed: true %}">
  {%- if section.settings.show_breadcrumbs -%}
    <div class="wrap" style="margin-bottom:24px">{% render 'breadcrumb' %}</div>
  {%- endif -%}
  <div class="pdp" data-pdp>
    {%- render 'product-gallery', product: product, finish: finish, ctx: 'pdp', views: section.settings.gallery_views, zoom: section.settings.enable_zoom, eager: true -%}
    {%- form 'product', product, id: form_id, class: 'dl-buy', novalidate: 'novalidate', data-product-form: '', data-ctx: 'pdp', data-section-id: section.id -%}
      {%- render 'product-json', product: product, financing_note: financing_note, financing_min: financing_min -%}
      {%- render 'product-templates', stock_text: stock_text -%}
      <select name="id" class="fc-input no-js-only" data-variant-select aria-label="{{ 'products.product.choose_finish_size' | t }}">
        {%- for variant in product.variants -%}
          <option value="{{ variant.id }}"{% if variant.id == base.id %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{{ variant.title | escape }}{% unless variant.available %} {{ 'products.product.sold_out_suffix' | t }}{% endunless %}</option>
        {%- endfor -%}
      </select>
      {%- assign head_done = false -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'badge', 'title', 'lead' -%}
            {%- unless head_done -%}
              {%- assign head_done = true -%}
              <div class="head">
                {%- for head_block in section.blocks -%}
                  {%- case head_block.type -%}
                    {%- when 'badge' -%}
                      {%- liquid
                        assign badge_text = head_block.settings.text
                        if badge_text == blank and settings.badge_new_auto
                          assign age_seconds = 'now' | date: '%s' | minus: 0
                          assign created_seconds = product.created_at | date: '%s' | minus: 0
                          assign age_days = age_seconds | minus: created_seconds | divided_by: 86400
                          if age_days <= settings.badge_new_days
                            assign badge_text = 'products.product.new' | t
                          endif
                        endif
                      -%}
                      {%- if badge_text != blank -%}
                        <span class="fc-badge fc-badge-{{ head_block.settings.tone | default: 'accent' }}" {{ head_block.shopify_attributes }}>{{ badge_text | escape }}</span>
                      {%- endif -%}
                    {%- when 'title' -%}
                      {%- if head_block.settings.show_vendor -%}<p class="t-overline" style="margin:0">{{ product.vendor | escape }}</p>{%- endif -%}
                      <h1 class="{% if head_block.settings.size == 'title-lg' %}t-title-lg{% else %}t-headline{% endif %}" style="margin-top:8px" {{ head_block.shopify_attributes }}>{{ product.title | escape }}</h1>
                    {%- when 'lead' -%}
                      {%- liquid
                        assign lead = head_block.settings.text
                        if lead == blank
                          assign lead = product.description | strip_html | truncatewords: head_block.settings.max_words
                        endif
                      -%}
                      {%- if lead != blank -%}
                        <p class="t-lead" {{ head_block.shopify_attributes }}>{{ lead | escape }}</p>
                      {%- endif -%}
                  {%- endcase -%}
                {%- endfor -%}
              </div>
            {%- endunless -%}

          {%- when 'price' -%}
            {%- liquid
              assign note = ''
              if block.settings.financing_note != blank and base.price >= financing_min
                assign monthly = base.price | divided_by: 12.0 | round | money
                assign note = block.settings.financing_note | replace: '{amount}', monthly
              endif
            -%}
            <div style="display:contents" {{ block.shopify_attributes }}>
              <div class="stack dl-price-block" style="gap:8px">
                {%- render 'price', product: product, variant: base, lg: true, note: note, show_unit: block.settings.show_unit_price, show_compare: block.settings.show_compare_at -%}
                {%- if block.settings.show_installments -%}{{ form | payment_terms }}{%- endif -%}
                {%- if block.settings.show_tax_note -%}{%- render 'product-price-notes' -%}{%- endif -%}
              </div>
{%- liquid
                assign sku_text = base.sku
                if selected_variant == blank and base.sku contains '-'
                  assign sku_tail = base.sku | split: '-' | last
                  assign sku_text = base.sku | remove_last: sku_tail | append: 'OS'
                endif
              -%}
              <p class="t-fine" style="margin:0" data-sku{% if sku_text == blank %} hidden{% endif %}>{% if sku_text != blank %}{{ 'products.product.sku' | t: sku: sku_text }}{% endif %}</p>
            </div>

          {%- when 'variant-picker' -%}
            <div style="display:contents" {{ block.shopify_attributes }}>
              {%- render 'product-options', product: product, ctx: 'pdp', finish: finish, selected_variant: selected_variant, show_size_guide: block.settings.show_size_guide -%}
            </div>

          {%- when 'engraving' -%}
            <div style="display:contents" {{ block.shopify_attributes }}>
              {%- render 'product-engraving', product: product, ctx: 'pdp', finish: finish, max: block.settings.max_length, label: block.settings.label -%}
            </div>

          {%- when 'purchase-options' -%}
            <div style="display:contents" {{ block.shopify_attributes }}>
              {%- render 'product-plans', product: product, variant: base, ctx: 'pdp', one_time_label: block.settings.one_time_label -%}
            </div>

          {%- when 'quantity' -%}
            {%- if block.settings.show -%}
              {%- capture qty_stepper -%}
                <div class="dl-qty" role="group" aria-label="{{ 'products.product.quantity' | t }}" data-pf-qty>
                  <button type="button" data-act="pf-qty" data-d="-1" aria-label="{{ 'accessibility.decrease_quantity' | t: title: product.title }}">{% render 'icon', icon: 'minus', size: 16 %}</button>
                  <input type="number" name="quantity" value="{{ block.settings.min }}" min="{{ block.settings.min }}" max="{{ block.settings.max }}" inputmode="numeric" aria-label="{{ 'products.product.quantity' | t }}" style="width:3ch;text-align:center;border:0;background:none;font:inherit;color:inherit">
                  <button type="button" data-act="pf-qty" data-d="1" aria-label="{{ 'accessibility.increase_quantity' | t: title: product.title }}">{% render 'icon', icon: 'plus', size: 16 %}</button>
                </div>
              {%- endcapture -%}
              {%- comment -%} Right above the buy buttons, the stepper sits on the Add to Bag line instead {%- endcomment -%}
              {%- assign next_block = section.blocks[forloop.index] -%}
              {%- if next_block.type == 'buy-buttons' -%}
                {%- capture qty_inline -%}<div class="dl-buy-qty" {{ block.shopify_attributes }}>{{ qty_stepper }}</div>{%- endcapture -%}
              {%- else -%}
                <div class="stack" style="gap:8px" {{ block.shopify_attributes }}>
                  <p class="fc-size-cap"><span class="fc-swatch-k">{{ 'products.product.quantity' | t }}</span></p>
                  {{ qty_stepper }}
                </div>
              {%- endif -%}
            {%- endif -%}

          {%- when 'buy-buttons' -%}
            <div class="stack" {{ block.shopify_attributes }}>
              {%- render 'product-gift-recipient', product: product, ctx: 'pdp', form: form -%}
              {%- comment -%} The stock notice leads, then the Add to Bag line {%- endcomment -%}
              {%- render 'product-buy', product: product, ctx: 'pdp', finish: finish, variant: selected_variant, label: block.settings.label, show_stock: availability_block.settings.show_stock, stock_text: stock_text, part: 'stock' -%}
              {%- if qty_inline != blank -%}
                <div class="dl-buy-row">
                  {{ qty_inline }}
                  <div class="dl-buy-add">
                    {%- render 'product-buy', product: product, ctx: 'pdp', finish: finish, variant: selected_variant, label: block.settings.label, show_stock: availability_block.settings.show_stock, stock_text: stock_text, part: 'add' -%}
                  </div>
                </div>
              {%- else -%}
                {%- render 'product-buy', product: product, ctx: 'pdp', finish: finish, variant: selected_variant, label: block.settings.label, show_stock: availability_block.settings.show_stock, stock_text: stock_text, part: 'add' -%}
              {%- endif -%}
              {%- if block.settings.show_dynamic_checkout -%}
                {%- liquid
                  assign pay_hidden = false
                  if product.available == false or selected_variant.available == false
                    assign pay_hidden = true
                  endif
                -%}
                <div class="dl-pay{% if selected_variant == blank %} is-blocked{% endif %}" data-payment-button data-act="pay-blocked"{% if pay_hidden %} hidden{% endif %}><div data-pay-inner{% if selected_variant == blank %} inert{% endif %}>{{ form | payment_button }}</div></div>
              {%- endif -%}
              {%- if availability_block -%}
                <div style="display:contents" {{ availability_block.shopify_attributes }}>
                  {%- if availability_block.settings.show_pickup and settings.pickup_enabled -%}
                    <div data-pickup style="display:contents">{% render 'product-pickup-row', variant: base %}</div>
                  {%- endif -%}
                  {%- if availability_block.settings.arrival_text != blank -%}
                    <div class="dl-pickup">{% render 'icon', icon: 'truck' %}<p style="margin:0">{{ availability_block.settings.arrival_text }}</p></div>
                  {%- endif -%}
                </div>
              {%- endif -%}
              {%- if gift_block and gift_block.settings.show -%}
                <div style="display:contents" {{ gift_block.shopify_attributes }}>
                  {%- render 'notice', tone: 'gift', title: gift_block.settings.title, text: gift_block.settings.text -%}
                </div>
              {%- endif -%}
            </div>

          {%- when 'availability' -%}
            {%- unless has_buy -%}
              <div class="stack" {{ block.shopify_attributes }}>
                {%- if block.settings.show_pickup and settings.pickup_enabled -%}
                  <div data-pickup style="display:contents">{% render 'product-pickup-row', variant: base %}</div>
                {%- endif -%}
                {%- if block.settings.arrival_text != blank -%}
                  <div class="dl-pickup">{% render 'icon', icon: 'truck' %}<p style="margin:0">{{ block.settings.arrival_text }}</p></div>
                {%- endif -%}
              </div>
            {%- endunless -%}

          {%- when 'gift-note' -%}
            {%- unless has_buy -%}
              {%- if block.settings.show -%}
                <div style="display:contents" {{ block.shopify_attributes }}>{% render 'notice', tone: 'gift', title: block.settings.title, text: block.settings.text %}</div>
              {%- endif -%}
            {%- endunless -%}

          {%- when 'collapsible' -%}
            {%- liquid
              assign body = block.settings.body
              if block.settings.source == 'page' and block.settings.page != blank
                assign body = block.settings.page.content
              endif
            -%}
            <div class="fc-acc" {{ block.shopify_attributes }}>
              <details class="fc-acc-item">
                <summary class="fc-acc-btn"><span>{{ block.settings.heading | escape }}</span>{% render 'icon', icon: 'plus', class: 'fc-acc-ico-plus' %}{% render 'icon', icon: 'minus', class: 'fc-acc-ico-minus' %}</summary>
                <div class="fc-acc-panel rte">{{ body }}</div>
              </details>
            </div>

          {%- when 'share' -%}
            {%- if section.settings.show_share -%}
              {%- liquid
                assign share_label = block.settings.label
                if share_label == blank
                  assign share_label = 'products.product.share' | t
                endif
              -%}
              {%- capture share_attrs %}data-act="share" data-url="{{ shop.url }}{{ product.url }}" data-title="{{ product.title | escape }}"{% if block.settings.native %} data-native{% endif %} {{ block.shopify_attributes }}{% endcapture -%}
              {%- render 'button', variant: 'link', label: share_label, icon: 'share-network', no_chev: true, attrs: share_attrs -%}
            {%- endif -%}

          {%- when 'custom_liquid' -%}
            <div class="dl-custom-liquid" {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>

          {%- when '@app' -%}
            {%- render block -%}
        {%- endcase -%}
      {%- endfor -%}
    {%- endform -%}
  </div>

  {%- if section.settings.show_sticky_bar -%}
    {%- liquid
      assign sticky_label = 'products.product.add_to_bag' | t
      assign sticky_act = 'add'
      if product.available == false
        assign sticky_label = 'products.product.sold_out' | t
        assign sticky_act = 'add-blocked'
      elsif selected_variant == blank
        assign sticky_label = 'products.product.select_size' | t
        assign sticky_act = 'sticky-pick'
      endif
    -%}
    <div class="dl-stickybuy" data-stickybuy aria-hidden="true">
      <div class="in">
        <div class="nm"><b>{{ product.title | escape }}</b><span class="t-caption" data-sticky-price>{{ base.price | money }}</span></div>
        <button type="button" class="fc-btn fc-btn-primary fc-btn-sm" data-act="{{ sticky_act }}" data-ctx="pdp" tabindex="-1"{% if sticky_act == 'add-blocked' %} aria-disabled="true"{% endif %}><span>{{ sticky_label }}</span></button>
      </div>
    </div>
  {%- endif -%}

  {%- if section.settings.enable_zoom -%}
    {%- assign zoom_template = 'products.product.zoom_title' | t: title: product.title, index: '__index__', count: '__count__' -%}
    <div class="app-ov" data-ov="zoom" hidden>
      <div class="dl-scrim" data-act="scrim"></div>
      <div class="app-dialog scheme-1 app-zoom" role="dialog" aria-modal="true" aria-labelledby="ov-title-zoom" data-ov-panel>
        <button type="button" class="fc-btn fc-btn-icon zclose" aria-label="{{ 'accessibility.close_zoom' | t }}" data-act="close" data-initial style="background:var(--canvas)">{% render 'icon', icon: 'x', size: 24 %}</button>
        <h2 id="ov-title-zoom" class="fc-sr" data-zoom-title data-template="{{ zoom_template | escape }}">{{ product.title | escape }}</h2>
        <div class="zplate" data-zoom-plate></div>
        <button type="button" class="fc-btn fc-btn-icon gal-nav prev" aria-label="{{ 'accessibility.previous_image' | t }}" data-act="zoom-nav" data-dir="-1" style="background:var(--canvas)">{% render 'icon', icon: 'caret-left', size: 24 %}</button>
        <button type="button" class="fc-btn fc-btn-icon gal-nav next" aria-label="{{ 'accessibility.next_image' | t }}" data-act="zoom-nav" data-dir="1" style="background:var(--canvas)">{% render 'icon', icon: 'caret-right', size: 24 %}</button>
        <p class="zcount" role="status" data-zoom-count></p>
      </div>
    </div>
  {%- endif -%}

  <div class="app-ov" data-ov="waitlist" hidden>
    <div class="dl-scrim" data-act="scrim"></div>
    <div class="app-dialog scheme-1" role="dialog" aria-modal="true" aria-labelledby="ov-title-waitlist" data-ov-panel>
      {%- assign waitlist_title = 'products.product.waitlist' | t -%}
      {%- render 'drawer-head', title: waitlist_title, id: 'ov-title-waitlist' -%}
      <div style="padding:0 var(--space-6) var(--space-6)">
        {%- form 'contact', class: 'dl-form', novalidate: 'novalidate', data-validate: '', data-form-ajax: '' -%}
          <p class="t-body muted" style="margin:0">{{ 'products.product.waitlist_intro' | t: title: product.title }}</p>
          <input type="hidden" name="contact[Waitlist]" value="{{ product.title | escape }}" data-waitlist-variant>
          {%- assign email_label = 'general.email_label' | t -%}
          {%- assign email_value = customer.email | default: '' -%}
          {%- render 'field', label: email_label, name: 'contact[email]', id: 'wl-email', type: 'email', value: email_value, autocomplete: 'email', required: true -%}
          {%- assign notify_label = 'products.product.waitlist_submit' | t -%}
          {%- assign busy_label = 'contact.sending' | t -%}
          {%- capture submit_attrs %}data-busy-label="{{ busy_label | escape }}"{% endcapture -%}
          {%- render 'button', label: notify_label, type: 'submit', size: 'lg', block: true, attrs: submit_attrs -%}
          <template data-success>
            {%- assign done_title = 'products.product.waitlist_done_title' | t -%}
            {%- assign done_text = 'products.product.waitlist_done_text' | t: title: product.title -%}
            {%- render 'notice', tone: 'success', title: done_title, text: done_text -%}
            <div style="margin-top:16px">{%- assign done_label = 'general.done' | t -%}{% render 'button', variant: 'secondary', label: done_label, block: true, attrs: 'data-act="close"' %}</div>
          </template>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

{%- if settings.seo_structured_data -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Product (main)",
  "tag": "section",
  "class": "dl-section dl-main-product",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1",
      "info": "Alternate schemes 1 and 2 down the page. Scheme 3 is dark."
    },
    {
      "type": "select",
      "id": "gallery_layout",
      "label": "Gallery layout",
      "default": "stacked",
      "options": [
        {
          "value": "stacked",
          "label": "Single image with thumbnails"
        },
        {
          "value": "grid",
          "label": "Two-column grid on desktop"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_zoom",
      "label": "Enable image zoom",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "gallery_sticky",
      "label": "Sticky gallery",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "gallery_views",
      "label": "Build detail, side and on-scale views from one photo",
      "default": true,
      "info": "Used when a finish has a single photo and the product has no other images."
    },
    {
      "type": "checkbox",
      "id": "show_sticky_bar",
      "label": "Show sticky buy bar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_share",
      "label": "Show share",
      "default": false
    },
    {
      "type": "header",
      "content": "Section padding",
      "info": "The same on every screen size."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 32,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 64,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "info": "Connect a product metafield to show a badge per product."
        },
        {
          "type": "select",
          "id": "tone",
          "label": "Tone",
          "default": "accent",
          "options": [
            {
              "value": "accent",
              "label": "Accent (new)"
            },
            {
              "value": "neutral",
              "label": "Neutral (engravable)"
            },
            {
              "value": "inverse",
              "label": "Dark (limited edition)"
            }
          ]
        }
      ]
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "size",
          "label": "Size",
          "default": "headline",
          "options": [
            {
              "value": "headline",
              "label": "Large (48px)"
            },
            {
              "value": "title-lg",
              "label": "Medium (32px)"
            }
          ]
        },
        {
          "type": "checkbox",
          "id": "show_vendor",
          "label": "Show vendor",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "show_sku_top",
          "label": "Show SKU",
          "default": false
        }
      ]
    },
    {
      "type": "lead",
      "name": "Lead",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "info": "Connect a product metafield for a line per product. Empty uses the start of the description."
        },
        {
          "type": "range",
          "id": "max_words",
          "label": "Max words",
          "default": 18,
          "min": 8,
          "max": 30,
          "step": 1
        },
        {
          "type": "checkbox",
          "id": "muted",
          "label": "Use muted text",
          "default": true
        }
      ]
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_compare_at",
          "label": "Show compare-at price",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_unit_price",
          "label": "Show unit price",
          "default": true
        },
        {
          "type": "text",
          "id": "financing_note",
          "label": "Financing note",
          "info": "Empty hides the note. Use {amount} for the monthly amount, for example: or {amount}/mo for 12 months."
        },
        {
          "type": "number",
          "id": "financing_min",
          "label": "Minimum price for the financing note",
          "default": 600,
          "info": "The note shows when the price is at or above this amount, in your store currency."
        },
        {
          "type": "checkbox",
          "id": "show_installments",
          "label": "Show Shop Pay Installments banner",
          "default": true,
          "info": "Shows when your store offers Shop Pay Installments."
        },
        {
          "type": "checkbox",
          "id": "show_tax_note",
          "label": "Show tax and shipping note",
          "default": true,
          "info": "Says when prices include tax, and links your shipping policy when you have one."
        }
      ]
    },
    {
      "type": "variant-picker",
      "name": "Variant picker",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "finish_style",
          "label": "Finish style",
          "default": "swatch",
