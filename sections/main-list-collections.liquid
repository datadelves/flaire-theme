{%- liquid
  assign scheme = section.settings.color_scheme | default: 'scheme-1'
  case section.settings.columns
    when '2'
      assign grid_class = 'g2'
    when '4'
      assign grid_class = 'g4'
    else
      assign grid_class = 'g3 keep3'
  endcase
  assign tile_blocks = section.blocks | where: 'type', 'collection-tile'
  assign feature_blocks = section.blocks | where: 'type', 'feature-tile'
  assign link_block = section.blocks | where: 'type', 'link' | first
  assign picked = 0
  for block in tile_blocks
    if block.settings.collection != blank
      assign picked = picked | plus: 1
    endif
  endfor
  assign shop_label = 'products.facets.shop' | t
-%}
<div class="band {{ scheme }}" data-section="main-list-collections" style="{% render 'section-padding', top: section.settings.padding_top, bottom: section.settings.padding_bottom %}">
  <div class="wrap">
    {%- paginate collections by 24 -%}
      <div class="grid {{ grid_class }}">
        {%- if picked > 0 -%}
          {%- for block in tile_blocks -%}
            {%- assign c = block.settings.collection -%}
            {%- if c == blank %}{% continue %}{% endif -%}
            {%- render 'main-list-collections-tile', c: c, image: block.settings.image, line: block.settings.line, show_count: section.settings.show_count, index: forloop.index, shop_label: shop_label, attrs: block.shopify_attributes -%}
          {%- endfor -%}
        {%- else -%}
          {%- liquid
            case section.settings.sort
              when 'alphabetical'
                assign list = collections | sort_natural: 'title'
              when 'products_high'
                assign list = collections | sort: 'all_products_count' | reverse
              else
                assign list = collections
            endcase
          -%}
          {%- for c in list -%}
            {%- if c.all_products_count == 0 and request.design_mode == false %}{% continue %}{% endif -%}
            {%- render 'main-list-collections-tile', c: c, show_count: section.settings.show_count, index: forloop.index, shop_label: shop_label -%}
          {%- else -%}
            {%- for i in (1..3) -%}
              <span class="fc-card" style="color:var(--ink)"><div class="fc-card-art" style="padding:32px">{% render 'specimen', kind: 'ring', metal: 'rose-gold', size: 220, label: '' %}</div><div class="fc-card-body"><h2 class="t-title" style="margin:0">{{ 'general.shop_all' | t }}</h2></div></span>
            {%- endfor -%}
          {%- endfor -%}
        {%- endif -%}
        {%- for block in feature_blocks -%}
          {%- if block.settings.headline != blank and block.settings.link != blank -%}
            <a class="fc-card" href="{{ block.settings.link }}" style="color:var(--ink)" {{ block.shopify_attributes }}><div class="fc-card-art" style="padding:32px">
              {%- if block.settings.image != blank -%}
                {%- render 'product-photo', image: block.settings.image, size: 220, alt: '' -%}
              {%- else -%}
                {%- render 'specimen', kind: 'band', metal: 'rose-gold', size: 220, label: '' -%}
              {%- endif -%}
            </div><div class="fc-card-body"><h2 class="t-title" style="margin:0">{{ block.settings.headline | escape }}</h2><span class="fc-btn fc-btn-link"><span>{{ shop_label }}</span></span></div></a>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if picked == 0 -%}{%- render 'pagination', paginate: paginate -%}{%- endif -%}
    {%- endpaginate -%}
    {%- if link_block and link_block.settings.label != blank and link_block.settings.link != blank -%}
      <div style="margin-top:32px;text-align:{% if link_block.settings.align == 'start' %}left{% else %}right{% endif %}" {{ link_block.shopify_attributes }}>
        {%- assign link_label = link_block.settings.label | escape -%}
        {%- render 'button', variant: 'link', label: link_label, url: link_block.settings.link -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Collection grid",
  "tag": "section",
  "class": "dl-section dl-main-list-collections",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1",
      "info": "Alternate schemes 1 and 2 down the page. Scheme 3 is dark."
    },
    {
      "type": "select",
      "id": "sort",
      "label": "Sort",
      "default": "manual",
      "options": [
        {
          "value": "manual",
          "label": "Manual"
        },
        {
          "value": "alphabetical",
          "label": "A–Z"
        },
        {
          "value": "products_high",
          "label": "Most pieces"
        }
      ]
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "default": "3",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show count",
      "default": true
    },
    {
      "type": "header",
      "content": "Section padding",
      "info": "Desktop sizes. Tablets, phones and Compact section spacing (Theme settings > Layout) scale them down in proportion."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 120,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 120,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "collection-tile",
      "name": "Collection tile",
      "limit": 24,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "line",
          "label": "Line"
        }
      ]
    },
    {
      "type": "feature-tile",
      "name": "Feature tile",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "headline",
          "label": "Headline"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "link",
      "name": "Link",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Shop all"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "align",
          "label": "Align",
          "default": "end",
          "options": [
            {
              "value": "start",
              "label": "Start"
            },
            {
              "value": "end",
              "label": "End"
            }
          ]
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": [
      "list-collections"
    ]
  },
  "limit": 1
}
{% endschema %}
