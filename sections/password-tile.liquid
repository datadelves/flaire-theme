{%- liquid
  assign scheme = section.settings.color_scheme | default: 'scheme-2'
  assign signup = section.blocks | where: 'type', 'signup' | first
  assign email_msg = 'general.email_invalid' | t
  assign panel_id = 'pw-enter-' | append: section.id
-%}
<div data-section="password-tile">
  <div class="fc-tile {{ scheme }} " style="{% render 'section-padding', top: section.settings.padding_top, bottom: section.settings.padding_bottom %}">
    <div class="fc-tile-copy">
      <div class="fc-nav-brand dl-pw-brand">
        {%- if settings.logo != blank -%}
          {%- render 'header-brand' -%}
        {%- else -%}
          {{- shop.name | escape -}}
        {%- endif -%}
      </div>
      {%- if section.settings.eyebrow != blank %}<p class="fc-tile-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif -%}
      {%- if section.settings.headline != blank %}<h1 class="t-hero">{{ section.settings.headline }}</h1>{% endif -%}
      {%- if section.settings.sub != blank %}<p class="fc-tile-sub">{{ section.settings.sub }}</p>{% endif -%}
      {%- if section.settings.show_password_message and shop.password_message != blank -%}
        <div class="fc-tile-sub dl-pw-message" data-password-message>{{ shop.password_message }}</div>
      {%- endif -%}

      {%- if signup and signup.settings.label != blank -%}
        <div class="fc-tile-actions" {{ signup.shopify_attributes }}>
          {%- assign signup_id = 'pw-notify-' | append: section.id -%}
          {%- form 'customer', id: signup_id, class: 'dl-form', style: 'flex-direction:row;align-items:flex-start;max-width:520px', novalidate: 'novalidate', data-validate: '', data-form: 'pw-notify' -%}
            {%- if form.posted_successfully? -%}
              {%- assign ok_title = 'password.signup_title' | t -%}
              {%- render 'notice', tone: 'success', title: ok_title, text: signup.settings.success -%}
            {%- else -%}
              <input type="hidden" name="contact[tags]" value="prospect,password page">
              {%- liquid
                assign email_err = ''
                if form.errors
                  assign email_err = email_msg
                endif
                assign email_id = 'pw-email-' | append: section.id
                assign email_placeholder = 'general.email_placeholder' | t
                assign notify_label = signup.settings.button
                if notify_label == blank
                  assign notify_label = 'general.subscribe' | t
                endif
                assign busy = 'general.subscribing' | t
              -%}
              <div style="flex:1;text-align:left">
                {%- capture email_attrs %}data-msg-required="{{ email_msg | escape }}" data-msg-invalid="{{ email_msg | escape }}"{% endcapture -%}
                {%- render 'field', label: signup.settings.label, name: 'contact[email]', id: email_id, type: 'email', placeholder: email_placeholder, autocomplete: 'email', required: true, error: email_err, attrs: email_attrs -%}
              </div>
              <div style="padding-top:30px">
                {%- capture busy_attrs %}data-busy-label="{{ busy | escape }}"{% endcapture -%}
                {%- render 'button', label: notify_label, type: 'submit', size: 'lg', attrs: busy_attrs -%}
              </div>
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}
    </div>
    <div class="fc-tile-art">
      <div class="hero-art" style="aspect-ratio:16/5">
        {%- if section.settings.image != blank -%}
          {{- section.settings.image | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '440, 880, 1320, 1600', sizes: '(min-width: 735px) 440px, 44vw', alt: section.settings.image_alt, class: 'fc-photo' -}}
        {%- else -%}
          {%- render 'specimen', kind: 'ring', metal: 'rose-gold', gem: 'diamond', size: 440, label: section.settings.image_alt -%}
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="{{ scheme }}" style="padding:0 var(--space-5) var(--space-10);text-align:center;margin-top:-1px">
    <div style="max-width:420px;margin:0 auto">
      {%- form 'storefront_password', id: 'pw-form', class: 'dl-form', style: 'margin:0 auto', novalidate: 'novalidate', data-validate: '', data-form: 'pw-enter' -%}
        {%- liquid
          assign pw_open = false
          assign pw_err = ''
          if form.errors
            assign pw_open = true
            assign pw_err = section.settings.password_error
            if pw_err == blank
              assign pw_err = 'password.error' | t
            endif
          endif
          assign pw_label = 'password.password' | t
          assign pw_id = 'pw-pass-' | append: section.id
          assign pw_submit = 'password.submit' | t
          assign toggle_label = section.settings.password_label
          if toggle_label == blank
            assign toggle_label = 'password.enter' | t
          endif
        -%}
        <a class="fc-btn fc-btn-link no-chev" href="#{{ panel_id }}" role="button" aria-expanded="{{ pw_open }}" aria-controls="{{ panel_id }}" data-act="toggle" data-focus-target{% if pw_open %} hidden{% endif %}><span>{{ toggle_label | escape }}</span></a>
        <div id="{{ panel_id }}" class="dl-form dl-pw-panel" style="margin:0 auto"{% unless pw_open %} hidden{% endunless %}>
          {%- assign pw_required = 'customer.login.password_error' | t -%}
          {%- capture pw_attrs %}data-msg-required="{{ pw_required | escape }}"{% endcapture -%}
          {%- render 'field', label: pw_label, name: 'password', id: pw_id, type: 'password', autocomplete: 'current-password', required: true, error: pw_err, attrs: pw_attrs -%}
          {%- render 'button', label: pw_submit, type: 'submit', size: 'lg', block: true -%}
        </div>
      {%- endform -%}
    </div>

    {%- capture socials -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'social' -%}
          {%- liquid
            assign social_key = 'social_' | append: block.settings.network
            assign social_link = block.settings.link | default: settings[social_key]
          -%}
          {%- if social_link != blank -%}
            {%- assign social_icon = block.settings.network | append: '-logo' -%}
            {%- assign social_label = block.settings.label | default: block.settings.network -%}
            <a href="{{ social_link }}" aria-label="{{ social_label | escape }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>{% render 'icon', icon: social_icon, size: 20 %}</a>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if socials != blank -%}
      <div class="dl-social" style="justify-content:center;margin-top:16px">{{ socials }}</div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- if block.type == 'message' and block.settings.show -%}
        {%- assign message_text = block.settings.text | strip_html | strip -%}
        {%- if message_text != blank -%}
          <div class="t-caption dl-pw-message" style="margin-top:16px;text-align:{% if block.settings.align == 'start' %}left{% else %}center{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}

    <p style="margin-top:16px"><span class="t-caption">{{ 'password.owner' | t }}</span> <a class="fc-btn fc-btn-link no-chev" href="/admin" style="font-size:14px"><span>{{ 'password.admin' | t }}</span></a></p>
  </div>
</div>

{% stylesheet %}
  /* no-JS: the "Enter using password" link targets the panel */
  html.no-js .dl-password-tile .dl-pw-panel:target { display: flex !important; }
  .dl-password-tile .dl-pw-message > * { margin: 0; }
  .dl-password-tile .dl-pw-brand { margin: 0 0 var(--space-8); }
  .dl-password-tile .dl-pw-brand img { margin: 0 auto; }
{% endstylesheet %}

{% schema %}
{
  "name": "Password page",
  "tag": "section",
  "class": "dl-section dl-password-tile",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Opening soon"
    },
    {
      "type": "inline_richtext",
      "id": "headline",
      "label": "Headline",
      "default": "Light, held."
    },
    {
      "type": "inline_richtext",
      "id": "sub",
      "label": "Supporting line",
      "default": "Leave your email and we will write on launch day."
    },
    {
      "type": "checkbox",
      "id": "show_password_message",
      "label": "Show password message",
      "default": true,
      "info": "Edit the message in Online Store > Preferences."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2",
      "info": "Alternate schemes 1 and 2 down the page. Scheme 3 is dark."
    },
    {
      "type": "text",
      "id": "password_label",
      "label": "Password link label",
      "default": "Enter using password"
    },
    {
      "type": "text",
      "id": "password_error",
      "label": "Password error",
      "default": "Incorrect password. Try again."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text"
    },
    {
      "type": "header",
      "content": "Section padding",
      "info": "Desktop sizes. Tablets, phones and Compact section spacing (Theme settings > Layout) scale them down in proportion."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 120,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 0,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "signup",
      "name": "Email signup",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Email address"
        },
        {
          "type": "text",
          "id": "button",
          "label": "Button",
          "default": "Notify me"
        },
        {
          "type": "text",
          "id": "success",
          "label": "Success",
          "default": "Thank you. We will write on launch day."
        }
      ]
    },
    {
      "type": "social",
      "name": "Social media icon",
      "limit": 4,
      "settings": [
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "network",
          "label": "Network",
          "default": "instagram",
          "options": [
            {
              "value": "instagram",
              "label": "Instagram"
            },
            {
              "value": "pinterest",
              "label": "Pinterest"
            },
            {
              "value": "tiktok",
              "label": "TikTok"
            },
            {
              "value": "youtube",
              "label": "YouTube"
            },
            {
              "value": "facebook",
              "label": "Facebook"
            }
          ]
        },
        {
          "type": "text",
          "id": "label",
          "label": "Accessible label",
          "default": "Instagram"
        }
      ]
    },
    {
      "type": "message",
      "name": "Message",
      "limit": 2,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Fine jewelry, made to be worn every day.</p>"
        },
        {
          "type": "checkbox",
          "id": "show",
          "label": "Show",
          "default": true
        },
        {
          "type": "select",
          "id": "align",
          "label": "Align",
          "default": "center",
          "options": [
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "start",
              "label": "Start"
            }
          ]
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": [
      "password"
    ]
  },
  "limit": 1
}
{% endschema %}
